---
import Base from './Base.astro';
import Footer from '../components/Footer.astro';
import Soie from '../components/Soie.astro';

/*
 * Gabarit des pages document (conditions, politique) : registre de
 * référence, pas de vente. Fond nuit pétrole uni (pas de soie),
 * wordmark discret en retour d'accueil, colonne de lecture unique
 * (~70-75 caractères), aucun CTA de conversion, footer standard.
 */
interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base title={title} description={description}>
  <Soie />
  <!-- section--voile : voile local supplémentaire, indispensable aux
       textes longs sur la soie -->
  <main class="document section--voile">
    <header class="entete">
      <a class="marque" href={`${base}/`}>Vestia</a>
    </header>

    <!-- Le conteneur standard des sections de l'accueil (section__inner) :
         mêmes largeur maximale et marges que « Le rituel Vestia » -->
    <article class="texte section__inner">
      <slot />
    </article>
  </main>
  <Footer />
</Base>

<style is:global>
  /* Couleur de secours derrière la soie, quel que soit le thème */
  body {
    background-color: #091e35;
  }
</style>

<style>
  .document {
    /* Le document impose les valeurs nuit, comme les sections sur la soie */
    --texte: #faf7f0;
    --or-trait: #c4a03c;
    --filet: rgba(250, 247, 240, 0.14);

    color: var(--texte);
    padding: clamp(2rem, 5vh, 3.5rem) clamp(1.25rem, 4vw, 3rem) var(--espace-section);
  }

  .entete {
    text-align: center;
    margin-bottom: clamp(2.5rem, 6vh, 4rem);
  }

  /* Le wordmark discret, en lien de retour vers l'accueil */
  .marque {
    font-family: var(--police-embleme);
    font-weight: 400;
    text-transform: uppercase;
    font-size: clamp(2.8rem, 9vw, 4.2rem);
    letter-spacing: 0.2em;
    margin-right: -0.2em;
    text-decoration: none;
    background-image: linear-gradient(
      168deg,
      #8e7429 0%,
      #c4a03c 26%,
      #f1da80 50%,
      #c4a03c 74%,
      #8e7429 100%
    );
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  /* ---------- la colonne de lecture ----------
     Largeur et centrage : le conteneur standard section__inner
     (sections.css) — aucune valeur locale */

  /* Titre de page : Baskerville au traitement lumière des H2 du site */
  .texte :global(h1) {
    font-size: clamp(2.4rem, 5.1vw, 3.6rem);
    line-height: 1.2;
    margin-bottom: var(--espace-bloc-sm);
    background-image:
      linear-gradient(
        105deg,
        transparent 30%,
        rgba(255, 248, 225, 0.1) 42%,
        rgba(255, 248, 225, 0.3) 50%,
        rgba(255, 248, 225, 0.1) 58%,
        transparent 70%
      ),
      linear-gradient(120deg, #a98a2e 0%, #c4a03c 40%, #e3c563 65%, #c4a03c 100%);
    background-size: 320% 100%, 100% 100%;
    background-position: 130% 0, 0 0;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: lumiere-balayage 12s ease-in-out infinite;
  }

  /* Titres de sections : Baskerville plus petits, sans animation */
  .texte :global(h2) {
    font-size: 1.35rem;
    margin-top: var(--espace-bloc-lg);
    margin-bottom: 0.8rem;
  }

  .texte :global(p),
  .texte :global(li) {
    opacity: 0.9;
  }

  .texte :global(p + p) {
    margin-top: var(--espace-bloc-xs);
  }

  .texte :global(ul) {
    margin: var(--espace-bloc-xs) 0;
    padding-left: 1.4rem;
  }

  .texte :global(li)::marker {
    color: var(--or-trait);
  }

  /* Montserrat n'est chargée qu'en 200/400/500 : pas de faux gras */
  .texte :global(strong) {
    font-weight: 500;
  }

  /* Les filets du markdown : la grammaire dorée du rituel */
  .texte :global(hr) {
    border: 0;
    border-top: 1px solid rgba(196, 160, 60, 0.35);
    margin-block: var(--espace-bloc-lg);
  }

  .texte :global(a) {
    color: var(--or-trait);
    text-decoration: none;
    border-bottom: 1px solid rgba(196, 160, 60, 0.35);
    transition: border-color 0.3s ease;
  }

  .texte :global(a:hover),
  .texte :global(a:focus-visible) {
    border-bottom-color: var(--or-trait);
  }
</style>
