---
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/sections.css';
import '../styles/lumiere.css';
import Temoins from '../components/Temoins.astro';
import SelecteurLangue from '../components/SelecteurLangue.astro';
import { ROUTES, t, type CleRoute, type Langue } from '../i18n';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  /* Langue de la page — le français reste la langue par défaut */
  langue?: Langue;
  /* Paire d'adresses équivalentes (hreflang + sélecteur de langue) */
  route?: CleRoute;
}

const { langue = 'fr', route = 'accueil' } = Astro.props;
const dico = t(langue);
const {
  title = dico.meta.accueil.titre,
  description = dico.meta.accueil.description,
  noindex = false,
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const cheminFr = `${ROUTES[route].fr}`;
const cheminEn = `${ROUTES[route].en}`;

/* Partage (Open Graph / Twitter) : les plateformes exigent des URL
   absolues, construites depuis `site` (astro.config.mjs). */
const urlCanonique = new URL(Astro.url.pathname, Astro.site).href;
const urlFr = new URL(`${base}${cheminFr}`, Astro.site).href;
const urlEn = new URL(`${base}${cheminEn}`, Astro.site).href;
const imagePartage = new URL(`${base}/og-vestia.jpg`, Astro.site).href;
const altPartage = dico.meta.altPartage;
---

<!doctype html>
<html lang={langue} data-theme="nuit">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- À RETIRER AU LANCEMENT : le site entier reste non indexable
         jusqu'à l'ouverture officielle (robots.txt fait de même). Le
         noindex par page ci-dessous (prop `noindex`, /reserver)
         reprendra alors son rôle. -->
    <meta name="robots" content="noindex, nofollow" />
    <!-- Fin du bloc à retirer au lancement -->
    {noindex && <meta name="robots" content="noindex" />}

    <!-- Paires de langues réciproques ; x-default vers le français,
         langue par défaut du site -->
    <link rel="alternate" hreflang="fr" href={urlFr} />
    <link rel="alternate" hreflang="en" href={urlEn} />
    <link rel="alternate" hreflang="x-default" href={urlFr} />

    <!-- Partage — image unique 1200×630 pour tout le site -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={urlCanonique} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imagePartage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={altPartage} />
    <meta property="og:locale" content={langue === 'en' ? 'en_CA' : 'fr_CA'} />
    <meta property="og:locale:alternate" content={langue === 'en' ? 'fr_CA' : 'en_CA'} />
    <meta property="og:site_name" content="Vestia" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imagePartage} />

    <!-- Favicon Vestia : monogramme V doré sur nuit pétrole, décliné
         depuis assets-source/vestia-favicon-source.png. Chemins relatifs
         à la base URL — valides après le branchement de vestia.ca. -->
    <link rel="icon" href={`${base}/favicon.ico`} sizes="48x48" />
    <link rel="icon" type="image/png" sizes="32x32" href={`${base}/favicon-32.png`} />
    <link rel="icon" type="image/png" sizes="16x16" href={`${base}/favicon-16.png`} />
    <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
    <link rel="manifest" href={`${base}/site.webmanifest`} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#091E35" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:opsz@6..96&family=Libre+Baskerville:ital@0;1&family=Montserrat:wght@200;400;500&display=swap"
      rel="stylesheet"
    />

    <script is:inline>
      /* Thème appliqué avant le premier rendu : choix mémorisé, sinon préférence système. */
      (() => {
        try {
          const memorise = localStorage.getItem('vestia-theme');
          const systeme = matchMedia('(prefers-color-scheme: light)').matches ? 'jour' : 'nuit';
          document.documentElement.dataset.theme =
            memorise === 'jour' || memorise === 'nuit' ? memorise : systeme;
        } catch {
          document.documentElement.dataset.theme = 'nuit';
        }
      })();
    </script>

    <script is:inline define:vars={{ langue, cheminFr, cheminEn, base }}>
      /* Langue mémorisée : seul le choix EXPLICITE du visiteur (clic
         sur la pastille FR | EN) est honoré à la navigation suivante —
         jamais la langue du navigateur (primauté du français). */
      (() => {
        try {
          const choix = localStorage.getItem('vestia-langue');
          if ((choix === 'fr' || choix === 'en') && choix !== langue) {
            const cible = base + (choix === 'en' ? cheminEn : cheminFr);
            if (cible !== location.pathname) {
              location.replace(cible + location.search + location.hash);
            }
          }
        } catch {
          /* stockage indisponible : la page s'affiche telle quelle */
        }
      })();
    </script>
  </head>
  <body>
    <SelecteurLangue langue={langue} cheminFr={cheminFr} cheminEn={cheminEn} />
    <slot />
    <!-- Consentement aux témoins (Loi 25) : bannière, modale et
         chargeur conditionnel des tags — sur toutes les pages -->
    <Temoins langue={langue} />
  </body>
</html>
