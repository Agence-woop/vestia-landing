---
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/sections.css';
import '../styles/lumiere.css';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const {
  title = 'Vestia — Repassage et cueillette à domicile, Montréal',
  description = 'Vos vêtements cueillis à votre porte, repassés à la main, retournés sur cintre. Griffintown, Cité du Multimédia, Vieux-Montréal.',
  noindex = false,
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

/* Partage (Open Graph / Twitter) : les plateformes exigent des URL
   absolues. Elles se construisent depuis `site` (astro.config.mjs) —
   à mettre à jour lors du branchement du domaine vestia.ca. */
const urlCanonique = new URL(Astro.url.pathname, Astro.site).href;
const imagePartage = new URL(`${base}/og-vestia.jpg`, Astro.site).href;
const altPartage = 'Vestia — Repassage et cueillette à domicile';
---

<!doctype html>
<html lang="fr" data-theme="nuit">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}

    <!-- Partage — image unique 1200×630 pour tout le site -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={urlCanonique} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imagePartage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={altPartage} />
    <meta property="og:locale" content="fr_CA" />
    <meta property="og:site_name" content="Vestia" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imagePartage} />

    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#091E35" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:opsz@6..96&family=Libre+Baskerville:ital@0;1&family=Montserrat:wght@200;400;500&display=swap"
      rel="stylesheet"
    />

    <script is:inline>
      /* Thème appliqué avant le premier rendu : choix mémorisé, sinon préférence système. */
      (() => {
        try {
          const memorise = localStorage.getItem('vestia-theme');
          const systeme = matchMedia('(prefers-color-scheme: light)').matches ? 'jour' : 'nuit';
          document.documentElement.dataset.theme =
            memorise === 'jour' || memorise === 'nuit' ? memorise : systeme;
        } catch {
          document.documentElement.dataset.theme = 'nuit';
        }
      })();
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
