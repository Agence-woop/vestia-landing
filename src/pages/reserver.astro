---
import Base from '../layouts/Base.astro';
import Footer from '../components/Footer.astro';
import Cta from '../components/Cta.astro';
import Soie from '../components/Soie.astro';

/*
 * Le parcours de réservation en trois écrans — une demande de cueillette
 * confirmée manuellement par message texte, pas une réservation
 * instantanée. Aucun backend : la soumission finale part vers Formspree
 * (endpoint provisoire, voir les constantes du script). Tout l'état vit
 * côté client ; les écrans restent dans le DOM, donc les saisies sont
 * conservées quand on revient en arrière.
 * noindex conservé jusqu'au lancement.
 */
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base
  title="Vestia — Réserver une cueillette"
  description="Demandez votre cueillette Vestia : adresse, jour et fenêtre de passage. Confirmation personnelle par message texte."
  noindex
>
  <Soie />
  <main class="section section--voile parcours">
    <header class="entete">
      <a class="marque" href={`${base}/`}>Vestia</a>
    </header>

    <!-- Le conteneur standard du site, comme l'accueil et les pages légales -->
    <div class="cadre section__inner">
      <div class="barre">
        <button type="button" class="retour" id="r-retour" hidden>‹ Retour</button>
        <p class="etape" id="etape" aria-live="polite">1&nbsp;/&nbsp;3</p>
      </div>

      <!-- ================= Écran 1 — L'adresse ================= -->
      <form class="ecran" id="ecran-1" novalidate>
        <h2>Votre adresse</h2>

        <div class="bloc">
          <label class="etiquette texte-champagne" for="r-code-postal">Votre code postal</label>
          <div class="saisie">
            <input
              class="champ"
              type="text"
              id="r-code-postal"
              name="code-postal"
              autocomplete="postal-code"
              maxlength="7"
              placeholder="H3C 1A1"
            />
            <button class="btn-secondaire" type="button" id="r-verifier">Vérifier</button>
          </div>
          <p class="erreur" aria-live="polite" hidden>Veuillez saisir un code postal valide.</p>
          <p class="dore texte-champagne" id="r-desservi" aria-live="polite" hidden>Vestia dessert votre adresse.</p>
        </div>

        <!-- Hors zone : le parcours s'arrête proprement ici -->
        <div class="bloc" id="r-hors-zone" hidden>
          <p class="promesse" aria-live="polite">
            Votre quartier n'y est pas encore. Laissez-nous votre courriel, il viendra.
          </p>
          <div class="saisie">
            <label class="visually-hidden" for="r-courriel-attente">Votre courriel</label>
            <input
              class="champ"
              type="email"
              id="r-courriel-attente"
              placeholder="Votre courriel"
              autocomplete="email"
            />
            <button class="btn-secondaire" type="button" id="r-prevenir">Prévenez-moi</button>
          </div>
          <p class="suite" aria-live="polite" hidden></p>
        </div>

        <div id="r-adresse" hidden>
          <div class="bloc">
            <label class="etiquette texte-champagne" for="r-rue">Numéro et rue</label>
            <input class="champ" type="text" id="r-rue" name="adresse" autocomplete="street-address" />
            <p class="erreur" aria-live="polite" hidden>Veuillez indiquer votre numéro et votre rue.</p>
          </div>
          <div class="bloc">
            <label class="etiquette texte-champagne" for="r-app">Appartement <span class="optionnel">(optionnel)</span></label>
            <input class="champ" type="text" id="r-app" name="appartement" />
            <p class="aide">
              Sans numéro d'appartement, votre intendant vous retrouve dans le hall d'entrée.
            </p>
          </div>
          <div class="bloc">
            <label class="etiquette texte-champagne" for="r-acces">Instructions d'accès <span class="optionnel">(optionnel)</span></label>
            <input class="champ" type="text" id="r-acces" name="instructions" placeholder="Code d'entrée, concierge, remarques…" />
          </div>
          <div class="actions">
            <Cta type="submit">Continuer</Cta>
          </div>
        </div>
      </form>

      <!-- ================= Écran 2 — La cueillette ================= -->
      <form class="ecran" id="ecran-2" hidden novalidate>
        <h2 class="titre-serre">Votre cueillette</h2>

        <div class="deux-col">
          <div class="col-gauche">
            <div class="bloc">
              <p class="etiquette texte-champagne">Le jour</p>
              <div class="calendrier surface-tuile" id="calendrier">
                <div class="cal-tete">
                  <button type="button" class="cal-nav" id="cal-prec" aria-label="Mois précédent">‹</button>
                  <p class="cal-mois" id="cal-mois" aria-live="polite"></p>
                  <button type="button" class="cal-nav" id="cal-suiv" aria-label="Mois suivant">›</button>
                </div>
                <div class="cal-corps" id="cal-corps">
                  <div class="cal-grille" id="cal-grille" role="grid" aria-label="Choisissez le jour de votre cueillette"></div>
                  <p class="cal-voile" id="cal-voile" hidden>Ouverture des cueillettes prochainement</p>
                </div>
              </div>
              <div class="legende" id="cal-legende" hidden>
                <p class="legende-item" id="leg-complet" hidden>
                  <span class="marque-complet" aria-hidden="true"></span>
                  <span><strong>Complet</strong> — la limite de cueillettes est atteinte</span>
                </p>
                <p class="legende-item" id="leg-ferie" hidden>
                  <span class="marque-ferie" aria-hidden="true"></span>
                  <span><strong>Fin de semaine ou férié</strong> — Vestia ne circule pas</span>
                </p>
              </div>
              <p class="erreur" aria-live="polite" hidden>Veuillez choisir un jour de cueillette.</p>
            </div>
          </div>

          <!-- La colonne se dévoile question par question : la fenêtre dès
               qu'un jour est choisi, le retour après la fenêtre, les pièces
               et la précision après le retour, le CTA après les pièces -->
          <div class="col-droite" id="r-droite">
            <p class="verrou" id="r-verrou" aria-live="polite">Choisissez d'abord un jour</p>
            <div class="droite-contenu" id="r-droite-contenu">
              <div class="bloc premier apparition" id="r-fenetres" hidden>
                <p class="etiquette texte-champagne">La fenêtre de cueillette</p>
                <fieldset class="groupe">
                  <legend>Matin</legend>
                  <div class="capsules" data-groupe="matin"></div>
                </fieldset>
                <fieldset class="groupe">
                  <legend>Fin de journée</legend>
                  <div class="capsules" data-groupe="soir"></div>
                </fieldset>
                <p class="erreur" aria-live="polite" hidden>Veuillez choisir une fenêtre de cueillette.</p>
              </div>

              <div class="bloc apparition" id="r-retour-groupe" hidden>
                <p class="etiquette texte-champagne">Le retour</p>
                <div class="capsules" id="r-retours"></div>
                <p class="rappel">Retour entre 17&nbsp;h&nbsp;30 et 19&nbsp;h&nbsp;30. Un message vous annonce notre arrivée.</p>
                <p class="erreur" aria-live="polite" hidden>Veuillez choisir un moment de retour.</p>
              </div>

              <div class="bloc apparition" id="r-pieces" hidden>
                <p class="etiquette texte-champagne">Combien de pièces avez-vous, environ?</p>
                <div class="capsules" id="r-tranches"></div>
                <p class="rappel">Minimum de 8 pièces. Le compte exact se fait avec vous, à la cueillette.</p>
                <p class="erreur" aria-live="polite" hidden>Veuillez choisir une tranche de pièces.</p>
              </div>

              <div class="bloc apparition" id="r-notes-groupe" hidden>
                <label class="etiquette texte-champagne" for="r-notes">Une précision pour votre intendant? <span class="optionnel">(optionnel)</span></label>
                <textarea class="champ" id="r-notes" name="notes" rows="2"></textarea>
              </div>
            </div>
          </div>
        </div>

        <!-- Le CTA, centré sous l'ensemble des deux colonnes -->
        <div class="actions apparition" id="r-continuer" hidden>
          <Cta type="submit">Continuer</Cta>
        </div>
      </form>

      <!-- ================= Écran 3 — Vos coordonnées ================= -->
      <form class="ecran" id="ecran-3" hidden novalidate>
        <h2>Vos coordonnées</h2>

        <div class="duo">
          <div class="bloc">
            <label class="etiquette texte-champagne" for="r-prenom">Prénom</label>
            <input class="champ" type="text" id="r-prenom" autocomplete="given-name" />
            <p class="erreur" aria-live="polite" hidden>Veuillez indiquer votre prénom.</p>
          </div>
          <div class="bloc">
            <label class="etiquette texte-champagne" for="r-nom">Nom</label>
            <input class="champ" type="text" id="r-nom" autocomplete="family-name" />
            <p class="erreur" aria-live="polite" hidden>Veuillez indiquer votre nom.</p>
          </div>
        </div>
        <div class="bloc">
          <label class="etiquette texte-champagne" for="r-courriel">Courriel</label>
          <input class="champ" type="email" id="r-courriel" autocomplete="email" />
          <p class="erreur" aria-live="polite" hidden>Veuillez saisir un courriel valide.</p>
        </div>
        <div class="bloc">
          <label class="etiquette texte-champagne" for="r-mobile">Mobile</label>
          <input class="champ" type="tel" id="r-mobile" autocomplete="tel" inputmode="tel" />
          <p class="aide">Votre confirmation arrive par message texte.</p>
          <p class="erreur" aria-live="polite" hidden>Veuillez saisir un numéro de mobile valide.</p>
        </div>

        <div class="tuile surface-tuile" id="r-recap" aria-live="polite"></div>

        <div class="bloc cases">
          <label class="case">
            <input type="checkbox" id="r-conditions" />
            <span>J'ai lu et j'accepte les
              <a href={`${base}/conditions-utilisation`} target="_blank" rel="noopener">conditions d'utilisation</a></span>
          </label>
          <p class="erreur" aria-live="polite" hidden>Veuillez accepter les conditions d'utilisation.</p>
          <label class="case">
            <input type="checkbox" id="r-infolettre" />
            <span>Tenez-moi informé des nouveautés Vestia</span>
          </label>
        </div>

        <div class="actions">
          <Cta type="submit">Envoyer ma demande</Cta>
          <p class="discret">Confirmation par message texte d'ici 2&nbsp;heures.</p>
          <p class="erreur" id="r-echec" aria-live="polite" hidden>
            L'envoi n'a pas fonctionné. Réessayez, ou écrivez-nous à info@vestia.ca.
          </p>
        </div>
      </form>

      <!-- ================= Confirmation ================= -->
      <div class="ecran confirmation" id="ecran-confirmation" hidden>
        <p class="recu">Votre demande est reçue.</p>
        <p class="suite-confirmation">
          Votre intendant Vestia vous confirme votre créneau par message texte d'ici 2&nbsp;heures.
        </p>
        <p class="dore texte-champagne" id="r-souhait"></p>
        <p class="discret">Demande envoyée en soirée? Votre confirmation arrive dès 7&nbsp;h.</p>
        <a class="retour" href={`${base}/`}>‹ Retour à l'accueil</a>
      </div>
    </div>
  </main>
  <Footer />
</Base>

<style is:global>
  /* Registre parcours : nuit pétrole uni, pas de soie */
  body {
    background-color: #091e35;
  }
</style>

<style>
  /* En-tête resserré : l'espace se récupère en haut pour que le CTA de
     l'étape 2 tienne dans un écran de 14 pouces */
  .parcours {
    min-height: 72svh;
    padding-top: var(--espace-bloc-md);
  }

  .entete {
    text-align: center;
    margin-bottom: var(--espace-bloc-sm);
  }

  /* Wordmark de cette page à ~60 % (les pages légales gardent leur ×3) */
  .marque {
    font-family: var(--police-embleme);
    font-weight: 400;
    text-transform: uppercase;
    font-size: clamp(1.7rem, 5.4vw, 2.5rem);
    letter-spacing: 0.2em;
    margin-right: -0.2em;
    text-decoration: none;
    background-image: linear-gradient(
      168deg,
      #8e7429 0%,
      #c4a03c 26%,
      #f1da80 50%,
      #c4a03c 74%,
      #8e7429 100%
    );
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  /* Le retour au-dessus du titre, l'indicateur d'étape en vis-à-vis */
  .barre {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.4rem;
    min-height: 1.4rem;
  }

  /* L'indicateur d'étape, en filigrane doré */
  .etape {
    font-size: 0.72rem;
    letter-spacing: 0.3em;
    color: var(--or-trait);
    opacity: 0.6;
    margin-left: auto;
  }

  /* ---------- les écrans ---------- */
  .ecran {
    opacity: 0;
    transform: translateY(0.4rem);
    transition:
      opacity 0.45s ease,
      transform 0.45s ease;
  }

  .ecran.visible {
    opacity: 1;
    transform: none;
  }

  .bloc {
    margin-top: var(--espace-bloc-md);
  }

  /* Étiquettes de champs, style conservé — réduites de ~3,7 pt : à 2-3 pt
     de moins, « Une précision pour votre intendant? (optionnel) » passait
     encore sur deux lignes en desktop */
  /* La couleur vient du traitement champagne commun (texte-champagne) */
  .etiquette {
    display: block;
    font-size: 1.05rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    margin-bottom: 0.6rem;
  }

  /* Chaque étiquette respire à son propre rythme */
  .bloc:nth-of-type(even) .etiquette {
    animation-delay: -4.5s;
  }

  .bloc:nth-of-type(3n) .etiquette {
    animation-delay: -8s;
    animation-duration: 13s;
  }

  .droite-contenu .etiquette {
    animation-delay: -6s;
    animation-duration: 14s;
  }

  /* La mention reste un aplat ocre : hors du clip champagne du parent,
     elle garde sa demi-teinte */
  .optionnel {
    text-transform: none;
    letter-spacing: 0.08em;
    color: var(--or-trait);
    opacity: 0.6;
  }

  .saisie {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: flex-end;
  }

  .saisie .champ {
    flex: 1;
    min-width: 9rem;
  }

  /* Sur la soie du parcours, les champs gardent leur filet bas mais
     reposent sur le fond des tuiles (tokens de sections.css) : la
     vidéo ne transparaît pas sous la saisie. Portée locale — le champ
     du vérificateur de zone de l'accueil ne change pas. */
  .champ {
    background-color: var(--surface);
    -webkit-backdrop-filter: var(--flou-surface);
    backdrop-filter: var(--flou-surface);
    border-radius: 0.55rem 0.55rem 0 0;
    padding: 0.65rem 0.8rem;
  }

  textarea.champ {
    resize: vertical;
    line-height: 1.6;
  }

  .erreur {
    margin-top: 0.6rem;
    font-size: 0.9rem;
    color: var(--erreur);
    opacity: 0.9;
  }

  /* La suite du bloc hors zone porte aussi les messages de validation */
  .suite.suite--erreur {
    color: var(--erreur);
  }

  .aide,
  .rappel {
    margin-top: 0.6rem;
    font-size: 0.85rem;
    opacity: 0.8;
  }

  .dore {
    margin-top: 1rem;
    font-family: var(--police-voix);
    font-size: 1.15rem;
    animation-delay: -5.5s;
    animation-duration: 14s;
  }

  .promesse {
    max-width: 52ch;
  }

  .suite {
    margin-top: 0.8rem;
    font-size: 0.95rem;
  }

  .duo {
    display: grid;
    gap: 0 1.5rem;
  }

  @media (min-width: 34rem) {
    .duo {
      grid-template-columns: 1fr 1fr;
    }
  }

  .actions {
    margin-top: var(--espace-bloc-lg);
    text-align: center;
  }

  /* ---------- écran 2 : deux colonnes en desktop ---------- */
  .deux-col {
    display: grid;
    gap: 0 var(--espace-bloc-lg);
  }

  @media (min-width: 64rem) {
    .deux-col {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: start;
    }
  }

  /* Espacement uniforme et fixe entre les groupes de la colonne
     droite — resserré d'un cran depuis l'ajout du groupe « Le retour »,
     pour que le CTA reste atteignable à 800 px de hauteur utile */
  .droite-contenu > .bloc + .bloc {
    margin-top: var(--espace-bloc-xs);
  }

  /* ---------- apparition progressive des questions ---------- */
  /* Fondu doux avec léger déplacement ; la réinitialisation globale de
     base.css rend l'apparition instantanée en prefers-reduced-motion */
  .apparition {
    opacity: 0;
    transform: translateY(0.4rem);
    transition:
      opacity 0.45s ease,
      transform 0.45s ease;
  }

  .apparition.visible {
    opacity: 1;
    transform: none;
  }

  /* L'espace titre → colonnes, resserré d'un cran */
  .titre-serre {
    margin-bottom: 0;
  }

  .deux-col .col-gauche > .bloc:first-child,
  .deux-col .verrou,
  .droite-contenu .bloc.premier {
    margin-top: var(--espace-bloc-xs);
  }

  #ecran-2 .actions {
    margin-top: var(--espace-bloc-xs);
  }

  .verrou {
    margin-top: var(--espace-bloc-md);
    font-size: 0.95rem;
    opacity: 0.8;
  }

  .droite-contenu {
    opacity: 0.35;
    transition: opacity 0.45s ease;
  }

  .col-droite.actif .verrou {
    display: none;
  }

  .col-droite.actif .droite-contenu {
    opacity: 1;
  }

  /* display: inline-block l'emporterait sinon sur l'attribut hidden —
     le « ‹ Retour » doit disparaître à l'écran 1 et à la confirmation */
  .retour[hidden] {
    display: none;
  }

  .retour {
    display: inline-block;
    margin-top: 1.2rem;
    font-size: 0.78rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--texte);
    opacity: 0.8;
    transition: opacity 0.3s ease;
  }

  .retour:hover,
  .retour:focus-visible {
    opacity: 1;
  }

  .discret {
    margin-top: 0.9rem;
    font-size: 0.85rem;
    opacity: 0.8;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  /* ---------- le calendrier ---------- */
  /* Fond et contour : la surface de tuile commune (sections.css),
     celle des tuiles tarifaires — la soie ne transparaît plus */
  .calendrier {
    padding: 0.8rem 1.1rem 0.9rem;
  }

  .calendrier::before {
    animation-delay: -3.5s;
    animation-duration: 12s;
  }

  .cal-tete {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.5rem;
  }

  .cal-mois {
    font-family: var(--police-voix);
    font-size: 1.05rem;
    text-transform: capitalize;
  }

  .cal-nav {
    width: 2.2rem;
    height: 2.2rem;
    border-radius: 50%;
    border: 1px solid var(--filet);
    color: var(--or-trait);
    font-size: 1rem;
    line-height: 1;
    transition: border-color 0.3s ease;
  }

  .cal-nav:hover:not(:disabled),
  .cal-nav:focus-visible {
    border-color: var(--or-trait);
  }

  .cal-nav:disabled {
    opacity: 0.3;
    cursor: default;
  }

  .cal-grille {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 0.3rem;
    text-align: center;
  }

  .cal-grille :global(.cal-jour-nom) {
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0.55;
    padding: 0.3rem 0;
  }

  .cal-grille :global(button.jour) {
    position: relative;
    aspect-ratio: 1;
    border-radius: 999px;
    font-size: 0.92rem;
    color: var(--texte);
    transition:
      background-color 0.25s ease,
      color 0.25s ease;
  }

  /* Journée complète : non sélectionnable mais lisible, barrée d'un
     trait oblique ocre fin (bas gauche → haut droite), bord à bord —
     le trait barre, il ne masque pas ; jamais une alerte */
  .cal-grille :global(button.jour.complet:disabled) {
    opacity: 0.75;
  }

  .cal-grille :global(button.jour.complet)::after {
    content: '';
    position: absolute;
    inset: 17%;
    border-radius: inherit;
    background: linear-gradient(
      to bottom right,
      transparent calc(50% - 0.75px),
      #c4a03c calc(50% - 0.75px),
      #c4a03c calc(50% + 0.75px),
      transparent calc(50% + 0.75px)
    );
    pointer-events: none;
  }

  /* En desktop, la case devient une capsule de hauteur contenue
     (cible cliquable ≥ 40 px) pour que l'étape tienne dans l'écran */
  /* Cases carrées rétablies (pastille dorée circulaire et centrée) :
     en desktop, la carte du calendrier se compacte en largeur plutôt
     que d'écraser la grille — la contrainte reste le CTA visible à
     800 px de hauteur utile */
  @media (min-width: 64rem) {
    .calendrier {
      max-width: 26rem;
    }
  }

  .cal-grille :global(button.jour:hover:not(:disabled)),
  .cal-grille :global(button.jour:focus-visible) {
    background: rgba(196, 160, 60, 0.18);
  }

  .cal-grille :global(button.jour:disabled) {
    opacity: 0.28;
    cursor: default;
  }

  /* Jours passés : très effacés, sans marqueur */
  .cal-grille :global(button.jour.passe:disabled) {
    opacity: 0.1;
  }

  /* ---------- le mois fermé, flouté ---------- */
  .cal-corps {
    position: relative;
  }

  .cal-corps.ferme .cal-grille {
    filter: blur(4px);
    opacity: 0.55;
    pointer-events: none;
  }

  .cal-corps.ferme .cal-grille :global(button.jour:disabled) {
    opacity: 0.8;
  }

  .cal-voile {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 1rem;
    font-size: 0.85rem;
    letter-spacing: 0.04em;
    opacity: 0.85;
  }

  /* display: flex l'emporterait sinon sur l'attribut hidden */
  .cal-voile[hidden] {
    display: none;
  }

  /* Le jour choisi : la capsule dorée des pills, parcourue du même
     balayage discret (couches de fond seulement — le texte nuit
     pétrole, peint au-dessus, ne change pas) */
  .cal-grille :global(button.jour.choisi) {
    background-image:
      linear-gradient(
        105deg,
        transparent 35%,
        rgba(255, 248, 225, 0.28) 50%,
        transparent 65%
      ),
      linear-gradient(#c4a03c, #c4a03c);
    background-size: 320% 100%, 100% 100%;
    background-position: 130% 0, 0 0;
    color: #091e35;
    font-weight: 500;
    animation: lumiere-balayage 12s ease-in-out infinite;
    animation-delay: -2.5s;
  }

  /* ---------- la légende du calendrier ---------- */
  .legende {
    margin-top: 0.7rem;
    padding-inline: 0.4rem;
  }

  .legende-item {
    display: flex;
    align-items: baseline;
    gap: 0.55rem;
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    opacity: 0.8;
  }

  .legende-item + .legende-item {
    margin-top: 0.3rem;
  }

  .legende strong {
    font-weight: 500;
  }

  .marque-complet {
    flex-shrink: 0;
    width: 7px;
    height: 7px;
    background: linear-gradient(
      to bottom right,
      transparent calc(50% - 0.75px),
      #c4a03c calc(50% - 0.75px),
      #c4a03c calc(50% + 0.75px),
      transparent calc(50% + 0.75px)
    );
  }

  .marque-ferie {
    flex-shrink: 0;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--texte);
    opacity: 0.28;
  }

  /* ---------- capsules (fenêtres, tranches) ---------- */
  .groupe {
    border: 0;
    padding: 0;
    margin: 0 0 1.1rem;
  }

  .groupe legend {
    font-size: 0.85rem;
    opacity: 0.9;
    margin-bottom: 0.6rem;
    padding: 0;
  }

  .capsules {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .capsules :global(label) {
    cursor: pointer;
  }

  .capsules :global(input) {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }

  .capsules :global(span) {
    display: inline-block;
    padding: 0.5em 1em;
    border-radius: 999px;
    border: 1px solid var(--filet);
    /* Le fond des tuiles (tokens de sections.css) : la capsule se
       détache nettement de la soie en mouvement */
    background-color: var(--surface);
    -webkit-backdrop-filter: var(--flou-surface);
    backdrop-filter: var(--flou-surface);
    font-size: 0.9rem;
    letter-spacing: 0.04em;
    white-space: nowrap;
    transition:
      background-color 0.25s ease,
      color 0.25s ease,
      border-color 0.25s ease;
  }

  .capsules :global(label:hover span),
  .capsules :global(input:focus-visible + span) {
    border-color: var(--or-trait);
  }

  .capsules :global(input:focus-visible + span) {
    outline: 1px solid var(--or-trait);
    outline-offset: 3px;
  }

  /* Capsule choisie : le balayage des pills tarifaires sur le fond
     ocre — couches de fond seulement, texte nuit pétrole intact */
  .capsules :global(input:checked + span) {
    background-image:
      linear-gradient(
        105deg,
        transparent 35%,
        rgba(255, 248, 225, 0.28) 50%,
        transparent 65%
      ),
      linear-gradient(#c4a03c, #c4a03c);
    background-size: 320% 100%, 100% 100%;
    background-position: 130% 0, 0 0;
    border-color: #c4a03c;
    color: #091e35;
    font-weight: 500;
    animation: lumiere-balayage 11s ease-in-out infinite;
  }

  /* Désynchronisation par groupe */
  [data-groupe='soir'] :global(input:checked + span) {
    animation-delay: -4s;
    animation-duration: 12s;
  }

  #r-retours :global(input:checked + span) {
    animation-delay: -5.5s;
    animation-duration: 14s;
  }

  #r-tranches :global(input:checked + span) {
    animation-delay: -7.5s;
    animation-duration: 13s;
  }

  /* ---------- la tuile récapitulative ---------- */
  /* Fond et contour : la surface de tuile commune (sections.css) */
  .tuile {
    margin-top: var(--espace-bloc-lg);
    padding: 1.4rem 1.5rem;
  }

  .tuile::before {
    animation-delay: -6.5s;
    animation-duration: 14s;
  }

  .tuile :global(p) {
    font-size: 0.95rem;
    opacity: 0.9;
  }

  .tuile :global(p + p) {
    margin-top: 0.4rem;
  }

  /* Montserrat n'est chargée qu'en 200/400/500 : pas de faux gras.
     Les étiquettes du récapitulatif dépassent les valeurs d'un bon
     point (0,95 rem → 1,05 rem) pour une hiérarchie visible. */
  .tuile :global(strong) {
    font-weight: 500;
    font-size: 1.05rem;
  }

  /* La couleur vient du traitement champagne commun */
  .tuile :global(.recap-titre) {
    font-size: 0.68rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    opacity: 1;
    margin-bottom: 0.7rem;
    animation-delay: -9s;
  }

  /* ---------- cases à cocher ---------- */
  .cases .case {
    display: flex;
    gap: 0.7rem;
    align-items: baseline;
    cursor: pointer;
  }

  .cases .case + .case {
    margin-top: 0.8rem;
  }

  .cases input {
    accent-color: #c4a03c;
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
    transform: translateY(0.15rem);
  }

  .cases span {
    font-size: 0.95rem;
    opacity: 0.9;
  }

  .cases a {
    color: var(--or-trait);
    text-decoration: none;
    border-bottom: 1px solid rgba(196, 160, 60, 0.35);
  }

  .cases a:hover,
  .cases a:focus-visible {
    border-bottom-color: var(--or-trait);
  }

  /* ---------- confirmation ---------- */
  .confirmation {
    text-align: center;
    padding-top: var(--espace-bloc-lg);
  }

  .recu {
    font-family: var(--police-voix);
    font-weight: 400;
    font-size: clamp(1.6rem, 4vw, 2.2rem);
  }

  .suite-confirmation {
    margin-top: var(--espace-bloc-xs);
    max-width: 42ch;
    margin-inline: auto;
  }

  .confirmation .retour {
    margin-top: var(--espace-bloc-lg);
  }
</style>

<script>
  import zones from '../data/zones.json';
  import joursIndisponibles from '../data/jours-indisponibles.json';

  /* ----------------------------------------------------------------
     Endpoints Formspree du compte Vestia. Isolés ici volontairement :
     - réservations : le formulaire de l'écran 3
     - liste d'attente : le bloc hors zone (le même identifiant que le
       « Prévenez-moi » de la section territoire de l'accueil)
  ---------------------------------------------------------------- */
  const FORMSPREE_RESERVATION_ENDPOINT = 'https://formspree.io/f/xjyvgnvp';
  const FORMSPREE_PREVENEZ_MOI = 'https://formspree.io/f/mdeoaqoy';

  const FENETRES_MATIN = ['7 h – 7 h 30', '7 h 30 – 8 h', '8 h – 8 h 30', '8 h 30 – 9 h'];
  const FENETRES_SOIR = ['17 h 30 – 18 h', '18 h – 18 h 30', '18 h 30 – 19 h', '19 h – 19 h 30'];
  const TRANCHES = ['8 – 10', '11 – 15', '16 – 20', '21 et plus'];

  const $ = (s: string) => document.querySelector(s) as HTMLElement;
  const montrer = (el: HTMLElement) => {
    el.hidden = false;
    requestAnimationFrame(() => requestAnimationFrame(() => el.classList.add('visible')));
  };

  /* ---------- l'état du parcours ---------- */
  const etat = {
    codePostal: '',
    jour: null as Date | null,
    fenetre: '',
    retour: '',
    retourDate: '',
    tranche: '',
  };

  const ecrans = [$('#ecran-1'), $('#ecran-2'), $('#ecran-3')] as HTMLFormElement[];
  let courant = 0;

  /* Affiche une étape sans toucher à l'historique */
  function montrerEcran(cible: number) {
    ecrans[courant].classList.remove('visible');
    ecrans[courant].hidden = true;
    courant = cible;
    const ecran = ecrans[courant];
    ecran.hidden = false;
    requestAnimationFrame(() => requestAnimationFrame(() => ecran.classList.add('visible')));
    $('#etape').innerHTML = `${courant + 1}&nbsp;/&nbsp;3`;
    ($('#r-retour') as HTMLButtonElement).hidden = courant === 0;
    window.scrollTo({ top: 0 });
    if (courant === 2) remplirRecap();
  }

  /* Avancer pousse une entrée d'historique : le bouton retour du
     navigateur ramène à l'étape précédente, données intactes */
  function avancer(cible: number) {
    history.pushState({ etape: cible }, '');
    montrerEcran(cible);
    sauvegarder();
  }

  window.addEventListener('popstate', (e) => {
    const et = e.state && typeof e.state.etape === 'number' ? e.state.etape : 0;
    montrerEcran(Math.max(0, Math.min(2, et)));
  });

  ecrans[0].classList.add('visible');
  /* Le bouton « ‹ Retour » du site passe par l'historique : un seul chemin */
  $('#r-retour').addEventListener('click', () => history.back());

  const afficherErreur = (bloc: Element | null, visible: boolean) => {
    const e = bloc?.querySelector('.erreur') as HTMLElement | null;
    if (e) e.hidden = !visible;
  };

  /* ================= Écran 1 — l'adresse ================= */
  const champCP = $('#r-code-postal') as HTMLInputElement;
  const blocCP = champCP.closest('.bloc');
  const horsZone = $('#r-hors-zone');
  const desservi = $('#r-desservi');
  const adresse = $('#r-adresse');

  $('#r-verifier').addEventListener('click', () => {
    afficherErreur(blocCP, false);
    desservi.hidden = true;
    horsZone.hidden = true;
    adresse.hidden = true;

    /* Normalisation et validation : identiques à la section territoire */
    const code = champCP.value.toUpperCase().replace(/[\s-]/g, '');
    champCP.value = code.length > 3 ? `${code.slice(0, 3)} ${code.slice(3)}` : code;
    if (!/^[A-Z]\d[A-Z]\d[A-Z]\d$/.test(code)) {
      afficherErreur(blocCP, true);
      return;
    }
    etat.codePostal = `${code.slice(0, 3)} ${code.slice(3)}`;
    if (zones.rta.includes(code.slice(0, 3))) {
      desservi.hidden = false;
      adresse.hidden = false;
    } else {
      horsZone.hidden = false;
    }
  });

  /* Hors zone : liste d'attente, le parcours s'arrête là */
  $('#r-prevenir').addEventListener('click', async () => {
    const courriel = ($('#r-courriel-attente') as HTMLInputElement).value.trim();
    const suite = horsZone.querySelector('.suite') as HTMLElement;
    if (!courriel || !courriel.includes('@')) {
      suite.textContent = 'Veuillez saisir un courriel valide.';
      suite.classList.add('suite--erreur');
      suite.hidden = false;
      return;
    }
    const donnees = new FormData();
    donnees.set('Courriel', courriel);
    donnees.set('Code postal', etat.codePostal);
    /* Objet lisible d'un coup d'œil et réponse directe au client */
    donnees.set('_subject', `LISTE D'ATTENTE — ${etat.codePostal}`);
    donnees.set('_replyto', courriel);
    try {
      const reponse = await fetch(FORMSPREE_PREVENEZ_MOI, {
        method: 'POST',
        headers: { Accept: 'application/json' },
        body: donnees,
      });
      if (!reponse.ok) throw new Error();
      (horsZone.querySelector('.saisie') as HTMLElement).hidden = true;
      suite.textContent = 'C’est noté. Vestia vous écrira.';
      suite.classList.remove('suite--erreur');
    } catch {
      suite.textContent = 'L’envoi n’a pas fonctionné. Réessayez, ou écrivez-nous à info@vestia.ca.';
      suite.classList.add('suite--erreur');
    }
    suite.hidden = false;
  });

  ecrans[0].addEventListener('submit', (e) => {
    e.preventDefault();
    const rue = $('#r-rue') as HTMLInputElement;
    const ok = rue.value.trim().length > 0;
    afficherErreur(rue.closest('.bloc'), !ok);
    if (ok) avancer(1);
  });

  /* ================= Écran 2 — le calendrier ================= */
  const FERIES = new Set(joursIndisponibles.feries);
  const COMPLETS = new Set(joursIndisponibles.complets);
  const cle = (d: Date) =>
    `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;

  const auMinuit = (d: Date) => new Date(d.getFullYear(), d.getMonth(), d.getDate());
  const aujourdHui = auMinuit(new Date());

  /* Ouverture par mois : le mois courant est entièrement ouvert ; dès
     qu'il reste 7 jours ou moins, le mois suivant s'ouvre à son tour.
     Le mois qui suit le dernier mois ouvert s'affiche flouté, rien
     au-delà n'est atteignable. Calculé à chaque chargement. */
  const indexMois = (annee: number, mois: number) => annee * 12 + mois;
  const courantIdx = indexMois(aujourdHui.getFullYear(), aujourdHui.getMonth());
  const finDuMois = new Date(aujourdHui.getFullYear(), aujourdHui.getMonth() + 1, 0).getDate();
  const dernierOuvertIdx = finDuMois - aujourdHui.getDate() <= 7 ? courantIdx + 1 : courantIdx;
  const flouteIdx = dernierOuvertIdx + 1;

  const selectionnable = (d: Date) => {
    const idx = indexMois(d.getFullYear(), d.getMonth());
    return (
      d > aujourdHui &&
      idx >= courantIdx &&
      idx <= dernierOuvertIdx &&
      d.getDay() !== 0 &&
      d.getDay() !== 6 &&
      !FERIES.has(cle(d)) &&
      !COMPLETS.has(cle(d))
    );
  };

  const formatLong = (d: Date) =>
    d.toLocaleDateString('fr-CA', { weekday: 'long', day: 'numeric', month: 'long' });

  const moisContientSelectionnable = (annee: number, mois: number) => {
    const fin = new Date(annee, mois + 1, 0).getDate();
    for (let j = 1; j <= fin; j += 1) {
      if (selectionnable(new Date(annee, mois, j))) return true;
    }
    return false;
  };

  /* Un mois affichable : un mois ouvert qui a des jours à offrir, ou le
     mois flouté — jamais une grille ouverte sans aucun jour */
  const moisAffichable = (annee: number, mois: number) => {
    const idx = indexMois(annee, mois);
    return idx === flouteIdx || (idx >= courantIdx && idx <= dernierOuvertIdx && moisContientSelectionnable(annee, mois));
  };

  let moisAffiche = new Date(aujourdHui.getFullYear(), aujourdHui.getMonth(), 1);
  if (!moisContientSelectionnable(moisAffiche.getFullYear(), moisAffiche.getMonth())) {
    moisAffiche = new Date(moisAffiche.getFullYear(), moisAffiche.getMonth() + 1, 1);
  }
  const grille = $('#cal-grille');

  function rendreCalendrier() {
    const annee = moisAffiche.getFullYear();
    const mois = moisAffiche.getMonth();
    $('#cal-mois').textContent = moisAffiche.toLocaleDateString('fr-CA', {
      month: 'long',
      year: 'numeric',
    });

    const idxAffiche = indexMois(annee, mois);
    const ferme = idxAffiche === flouteIdx;
    const prec = new Date(annee, mois - 1, 1);
    const suiv = new Date(annee, mois + 1, 1);
    ($('#cal-prec') as HTMLButtonElement).disabled = !moisAffichable(prec.getFullYear(), prec.getMonth());
    ($('#cal-suiv') as HTMLButtonElement).disabled = !moisAffichable(suiv.getFullYear(), suiv.getMonth());

    /* Le mois fermé : grille floutée et assombrie sous un mot d'attente,
       entièrement non interactive — l'en-tête du mois reste nette */
    $('#cal-corps').classList.toggle('ferme', ferme);
    ($('#cal-voile') as HTMLElement).hidden = !ferme;

    grille.innerHTML = '';
    for (const nom of ['lun', 'mar', 'mer', 'jeu', 'ven', 'sam', 'dim']) {
      const t = document.createElement('span');
      t.className = 'cal-jour-nom';
      t.textContent = nom;
      grille.appendChild(t);
    }
    /* Semaine commençant le lundi */
    const decalage = (new Date(annee, mois, 1).getDay() + 6) % 7;
    for (let v = 0; v < decalage; v += 1) grille.appendChild(document.createElement('span'));

    const fin = new Date(annee, mois + 1, 0).getDate();
    let moisAFerie = false;
    let moisAComplet = false;
    for (let j = 1; j <= fin; j += 1) {
      const date = new Date(annee, mois, j);
      const b = document.createElement('button');
      b.type = 'button';
      b.className = 'jour';
      b.textContent = String(j);
      b.setAttribute('aria-label', formatLong(date));

      /* Mois flouté : jours uniformes, cachés des lecteurs d'écran */
      if (ferme) {
        b.disabled = true;
        b.setAttribute('aria-hidden', 'true');
        b.tabIndex = -1;
        grille.appendChild(b);
        continue;
      }

      const semaine = date.getDay() !== 0 && date.getDay() !== 6;
      if (!selectionnable(date)) {
        b.disabled = true;
        /* Hiérarchie du mois ouvert : passés très effacés, fins de
           semaine et fériés grisés, journées complètes grisées avec
           leur trait oblique. Une date de liste tombant une fin de
           semaine reste un simple jour grisé, sans marqueur. */
        if (date <= aujourdHui) {
          b.classList.add('passe');
        } else if (semaine && FERIES.has(cle(date))) {
          b.setAttribute('aria-label', `${formatLong(date)} — férié`);
          b.setAttribute('aria-disabled', 'true');
          moisAFerie = true;
        } else if (semaine && COMPLETS.has(cle(date))) {
          b.classList.add('complet');
          b.setAttribute('aria-label', `${formatLong(date)} — complet`);
          b.setAttribute('aria-disabled', 'true');
          moisAComplet = true;
        }
      } else {
        b.addEventListener('click', () => {
          etat.jour = date;
          grille.querySelectorAll('.choisi').forEach((x) => x.classList.remove('choisi'));
          b.classList.add('choisi');
          activerDroite();
          /* Les libellés du retour suivent le jour choisi */
          if (etat.fenetre) rendreRetours();
          afficherErreur($('#calendrier').closest('.bloc'), false);
          sauvegarder();
        });
      }
      if (etat.jour && date.getTime() === etat.jour.getTime()) b.classList.add('choisi');
      grille.appendChild(b);
    }

    /* Les entrées de légende suivent le mois affiché */
    ($('#leg-ferie') as HTMLElement).hidden = !moisAFerie;
    ($('#leg-complet') as HTMLElement).hidden = !moisAComplet;
    ($('#cal-legende') as HTMLElement).hidden = !(moisAFerie || moisAComplet);
  }

  $('#cal-prec').addEventListener('click', () => {
    moisAffiche = new Date(moisAffiche.getFullYear(), moisAffiche.getMonth() - 1, 1);
    rendreCalendrier();
  });
  $('#cal-suiv').addEventListener('click', () => {
    moisAffiche = new Date(moisAffiche.getFullYear(), moisAffiche.getMonth() + 1, 1);
    rendreCalendrier();
  });

  /* Navigation au clavier dans la grille */
  grille.addEventListener('keydown', (e) => {
    const touches: Record<string, number> = { ArrowLeft: -1, ArrowRight: 1, ArrowUp: -7, ArrowDown: 7 };
    if (!(e.key in touches)) return;
    const jours = Array.from(grille.querySelectorAll('button.jour:not(:disabled)')) as HTMLElement[];
    const i = jours.indexOf(document.activeElement as HTMLElement);
    if (i === -1) return;
    e.preventDefault();
    const cible = jours[Math.min(jours.length - 1, Math.max(0, i + (Math.abs(touches[e.key]) === 7 ? touches[e.key] > 0 ? 5 : -5 : touches[e.key])))];
    cible?.focus();
  });

  rendreCalendrier();

  /* Fenêtres et tranches en capsules radio */
  function capsule(nom: string, valeur: string, conteneur: Element) {
    const label = document.createElement('label');
    const input = document.createElement('input');
    input.type = 'radio';
    input.name = nom;
    input.value = valeur;
    const span = document.createElement('span');
    span.textContent = valeur;
    label.append(input, span);
    conteneur.appendChild(label);
    return input;
  }

  /* ---------- le retour, en jours ouvrables ----------
     Les libellés nomment le jour de la semaine concerné, calculé depuis
     le JOUR DE CUEILLETTE choisi — jamais depuis la date du jour.
     Samedi, dimanche et fériés du JSON sont sautés. Les dates sont
     manipulées en heure locale et en jours de calendrier (jamais en
     durées de 24 h) : le calcul reste juste au changement d'heure. */
  const RETOUR_CONVENIR = 'On en convient ensemble';

  const jourOuvrableSuivant = (d: Date) => {
    let n = new Date(d.getFullYear(), d.getMonth(), d.getDate() + 1);
    while (n.getDay() === 0 || n.getDay() === 6 || FERIES.has(cle(n))) {
      n = new Date(n.getFullYear(), n.getMonth(), n.getDate() + 1);
    }
    return n;
  };

  /* « Mercredi soir » — majuscule initiale dans les capsules */
  const libelleSoir = (cible: Date) => {
    const nom = cible.toLocaleDateString('fr-CA', { weekday: 'long' });
    return `${nom.charAt(0).toUpperCase()}${nom.slice(1)} soir`;
  };

  /* Les trois options : libellé + date résolue (null pour « à convenir ») */
  function optionsRetour(): Array<{ libelle: string; date: Date | null }> {
    if (!etat.jour || !etat.fenetre) return [];
    const j1 = jourOuvrableSuivant(etat.jour);
    if (FENETRES_MATIN.includes(etat.fenetre)) {
      return [
        { libelle: libelleSoir(etat.jour), date: etat.jour },
        { libelle: libelleSoir(j1), date: j1 },
        { libelle: RETOUR_CONVENIR, date: null },
      ];
    }
    const j2 = jourOuvrableSuivant(j1);
    return [
      { libelle: libelleSoir(j1), date: j1 },
      { libelle: libelleSoir(j2), date: j2 },
      { libelle: RETOUR_CONVENIR, date: null },
    ];
  }

  /* (Re)construit les capsules de retour. Si un choix antérieur change,
     la sélection est conservée tant que son libellé existe encore, et
     réinitialisée sinon. */
  function rendreRetours() {
    const conteneur = $('#r-retours');
    const options = optionsRetour();
    const precedent = etat.retour;
    conteneur.innerHTML = '';
    for (const o of options) {
      capsule('retour', o.libelle, conteneur).addEventListener('change', () => {
        etat.retour = o.libelle;
        etat.retourDate = o.date ? formatLong(o.date) : '';
        afficherErreur($('#r-retour-groupe'), false);
        montrer($('#r-pieces'));
        montrer($('#r-notes-groupe'));
      });
    }
    if (precedent) {
      if (options.some((o) => o.libelle === precedent)) {
        poserRadio('retour', precedent);
      } else {
        etat.retour = '';
        etat.retourDate = '';
      }
    }
  }

  for (const f of [...FENETRES_MATIN, ...FENETRES_SOIR]) {
    const groupe = FENETRES_MATIN.includes(f) ? 'matin' : 'soir';
    capsule('fenetre', f, document.querySelector(`[data-groupe="${groupe}"]`)!).addEventListener(
      'change',
      () => {
        etat.fenetre = f;
        afficherErreur($('#r-fenetres'), false);
        rendreRetours();
        montrer($('#r-retour-groupe'));
      }
    );
  }
  for (const t of TRANCHES) {
    capsule('tranche', t, $('#r-tranches')).addEventListener('change', () => {
      etat.tranche = t;
      afficherErreur($('#r-pieces'), false);
      montrer($('#r-continuer'));
    });
  }

  /* La colonne droite reste estompée et inerte tant qu'aucun jour
     n'est choisi */
  const droite = $('#r-droite');
  const droiteContenu = $('#r-droite-contenu') as HTMLElement & { inert: boolean };
  droiteContenu.inert = true;

  function activerDroite() {
    droite.classList.add('actif');
    droiteContenu.inert = false;
    montrer($('#r-fenetres'));
  }

  ecrans[1].addEventListener('submit', (e) => {
    e.preventDefault();
    const okJour = etat.jour !== null;
    const okFenetre = etat.fenetre !== '';
    const okRetour = etat.retour !== '';
    const okTranche = etat.tranche !== '';
    afficherErreur($('#calendrier').closest('.bloc'), !okJour);
    afficherErreur($('#r-fenetres'), okJour && !okFenetre);
    afficherErreur($('#r-retour-groupe'), okFenetre && !okRetour);
    afficherErreur($('#r-pieces'), !okTranche);
    if (okJour && okFenetre && okRetour && okTranche) avancer(2);
  });

  /* ================= Écran 3 — coordonnées et envoi ================= */
  function adresseComplete() {
    const rue = ($('#r-rue') as HTMLInputElement).value.trim();
    const app = ($('#r-app') as HTMLInputElement).value.trim();
    return `${rue}${app ? `, app. ${app}` : ''}, ${etat.codePostal}`;
  }

  /* Le retour en clair, avec la date pour lever toute ambiguïté :
     « jeudi 3 septembre, 17 h 30 – 19 h 30 » ou « à convenir ensemble » */
  const retourEnClair = () =>
    etat.retour === RETOUR_CONVENIR
      ? 'à convenir ensemble'
      : `${etat.retourDate}, 17 h 30 – 19 h 30`;

  /* Quatre lignes étiquetées — étiquette en gras, valeur en graisse
     normale, aucune espace avant les deux points (typographie
     québécoise) */
  function remplirRecap() {
    $('#r-recap').innerHTML = `
      <p class="recap-titre texte-champagne">Votre demande</p>
      <p><strong>Adresse:</strong> ${adresseComplete()}</p>
      <p><strong>Cueillette:</strong> ${formatLong(etat.jour!)}, ${etat.fenetre}</p>
      <p><strong>Retour:</strong> ${retourEnClair()}</p>
      <p><strong>Volume:</strong> ${etat.tranche} pièces</p>
    `;
  }

  const courrielValide = (v: string) => /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(v);
  const mobileValide = (v: string) =>
    /^(\+?1[\s.-]?)?\(?\d{3}\)?[\s.-]?\d{3}[\s.-]?\d{4}$/.test(v.trim());

  /* ---------- formatage du mobile au fil de la frappe ----------
     Normalise toute saisie ou tout collage au format nord-américain
     (438) 506-3210 ; l'indicatif 1 en tête est retiré. On ne reformate
     pas pendant un effacement, pour ne pas coincer la correction. */
  const formaterMobile = (v: string) => {
    let c = v.replace(/\D/g, '');
    if (c.length === 11 && c.startsWith('1')) c = c.slice(1);
    c = c.slice(0, 10);
    if (c.length === 0) return '';
    if (c.length <= 3) return `(${c}`;
    if (c.length <= 6) return `(${c.slice(0, 3)}) ${c.slice(3)}`;
    return `(${c.slice(0, 3)}) ${c.slice(3, 6)}-${c.slice(6)}`;
  };

  const champMobile = $('#r-mobile') as HTMLInputElement;
  champMobile.addEventListener('input', (e) => {
    if ((e as InputEvent).inputType?.startsWith('delete')) return;
    const formate = formaterMobile(champMobile.value);
    if (formate !== champMobile.value) champMobile.value = formate;
  });

  ecrans[2].addEventListener('submit', async (e) => {
    e.preventDefault();
    const prenom = $('#r-prenom') as HTMLInputElement;
    const nom = $('#r-nom') as HTMLInputElement;
    const courriel = $('#r-courriel') as HTMLInputElement;
    const mobile = $('#r-mobile') as HTMLInputElement;
    const conditions = $('#r-conditions') as HTMLInputElement;

    const okPrenom = prenom.value.trim().length > 0;
    const okNom = nom.value.trim().length > 0;
    const okCourriel = courrielValide(courriel.value.trim());
    const okMobile = mobileValide(mobile.value);
    const okConditions = conditions.checked;
    afficherErreur(prenom.closest('.bloc'), !okPrenom);
    afficherErreur(nom.closest('.bloc'), !okNom);
    afficherErreur(courriel.closest('.bloc'), !okCourriel);
    afficherErreur(mobile.closest('.bloc'), !okMobile);
    afficherErreur(conditions.closest('.cases'), !okConditions);
    $('#r-echec').hidden = true;
    if (!(okPrenom && okNom && okCourriel && okMobile && okConditions)) return;

    const jourLong = formatLong(etat.jour!);
    /* Objet lisible d'un coup d'œil sur téléphone, réponse directe au
       client, puis les champs dans l'ordre naturel de lecture d'une
       demande — noms explicites en français */
    const donnees = new FormData();
    donnees.set('_subject', `CUEILLETTE — ${jourLong}, ${etat.fenetre} — ${prenom.value.trim()} ${nom.value.trim()}`);
    donnees.set('_replyto', courriel.value.trim());
    donnees.set('Prénom', prenom.value.trim());
    donnees.set('Nom', nom.value.trim());
    donnees.set('Courriel', courriel.value.trim());
    donnees.set('Mobile', mobile.value.trim());
    donnees.set('Adresse', ($('#r-rue') as HTMLInputElement).value.trim());
    donnees.set('Appartement', ($('#r-app') as HTMLInputElement).value.trim());
    donnees.set('Code postal', etat.codePostal);
    donnees.set("Instructions d'accès", ($('#r-acces') as HTMLInputElement).value.trim());
    donnees.set('Jour de cueillette', jourLong);
    donnees.set('Fenêtre de cueillette', etat.fenetre);
    donnees.set('Retour', retourEnClair());
    donnees.set('Volume', `${etat.tranche} pièces`);
    donnees.set('Précision', ($('#r-notes') as HTMLTextAreaElement).value.trim());
    donnees.set('Infolettre', ($('#r-infolettre') as HTMLInputElement).checked ? 'oui' : 'non');

    try {
      const reponse = await fetch(FORMSPREE_RESERVATION_ENDPOINT, {
        method: 'POST',
        headers: { Accept: 'application/json' },
        body: donnees,
      });
      if (!reponse.ok) throw new Error();
      /* La confirmation remplace le formulaire ; l'état de session est effacé */
      sessionStorage.removeItem(CLE_SESSION);
      ecrans[2].classList.remove('visible');
      ecrans[2].hidden = true;
      $('#etape').hidden = true;
      ($('#r-retour') as HTMLButtonElement).hidden = true;
      /* Deux lignes distinctes — valeurs générées par le site, sans
         saisie utilisateur */
      $('#r-souhait').innerHTML =
        `Cueillette souhaitée: ${jourLong}, ${etat.fenetre}<br />Retour: ${retourEnClair()}`;
      montrer($('#ecran-confirmation'));
      window.scrollTo({ top: 0 });
    } catch {
      /* Les données saisies restent en place */
      $('#r-echec').hidden = false;
    }
  });

  /* ================= Persistance de session ================= */
  const CLE_SESSION = 'vestia-reservation';
  const valeur = (id: string) => ($(`#${id}`) as HTMLInputElement).value;
  const cocher = (id: string) => ($(`#${id}`) as HTMLInputElement).checked;

  function sauvegarder() {
    const j = etat.jour;
    const donnees = {
      etape: courant,
      cp: valeur('r-code-postal'),
      codePostal: etat.codePostal,
      desservi: !adresse.hidden,
      rue: valeur('r-rue'),
      app: valeur('r-app'),
      acces: valeur('r-acces'),
      jour: j ? `${j.getFullYear()}-${j.getMonth() + 1}-${j.getDate()}` : '',
      fenetre: etat.fenetre,
      retour: etat.retour,
      retourDate: etat.retourDate,
      tranche: etat.tranche,
      notes: valeur('r-notes'),
      prenom: valeur('r-prenom'),
      nom: valeur('r-nom'),
      courriel: valeur('r-courriel'),
      mobile: valeur('r-mobile'),
      conditions: cocher('r-conditions'),
      infolettre: cocher('r-infolettre'),
    };
    try {
      sessionStorage.setItem(CLE_SESSION, JSON.stringify(donnees));
    } catch {
      /* stockage indisponible : le parcours fonctionne sans persistance */
    }
  }

  const poserValeur = (id: string, v: string) => {
    ($(`#${id}`) as HTMLInputElement).value = v ?? '';
  };
  const poserCoche = (id: string, v: boolean) => {
    ($(`#${id}`) as HTMLInputElement).checked = Boolean(v);
  };
  const poserRadio = (nom: string, v: string) => {
    const input = document.querySelector(
      `input[name="${nom}"][value="${v}"]`
    ) as HTMLInputElement | null;
    if (input) {
      input.checked = true;
      input.dispatchEvent(new Event('change'));
    }
  };

  /* Restauration après rechargement, puis reconstruction de
     l'historique (une entrée par étape déjà franchie) */
  function restaurer() {
    let d: any = null;
    try {
      d = JSON.parse(sessionStorage.getItem(CLE_SESSION) ?? 'null');
    } catch {
      d = null;
    }
    history.replaceState({ etape: 0 }, '');
    if (!d) return;

    poserValeur('r-code-postal', d.cp);
    poserValeur('r-rue', d.rue);
    poserValeur('r-app', d.app);
    poserValeur('r-acces', d.acces);
    poserValeur('r-notes', d.notes);
    poserValeur('r-prenom', d.prenom);
    poserValeur('r-nom', d.nom);
    poserValeur('r-courriel', d.courriel);
    poserValeur('r-mobile', d.mobile);
    poserCoche('r-conditions', d.conditions);
    poserCoche('r-infolettre', d.infolettre);

    if (d.codePostal) etat.codePostal = d.codePostal;
    if (d.desservi) {
      desservi.hidden = false;
      adresse.hidden = false;
    }
    if (d.jour) {
      const [a, m, jj] = String(d.jour).split('-').map(Number);
      const date = new Date(a, m - 1, jj);
      if (selectionnable(date)) {
        etat.jour = date;
        moisAffiche = new Date(a, m - 1, 1);
        rendreCalendrier();
        activerDroite();
      }
    }
    /* La fenêtre reconstruit les capsules de retour, puis le retour se
       replace s'il est toujours offert */
    if (d.fenetre) poserRadio('fenetre', d.fenetre);
    if (d.retour) poserRadio('retour', d.retour);
    if (d.tranche) poserRadio('tranche', d.tranche);

    const etape = Math.max(0, Math.min(2, Number(d.etape) || 0));
    for (let i = 1; i <= etape; i += 1) history.pushState({ etape: i }, '');
    if (etape > 0) montrerEcran(etape);
  }

  /* Chaque saisie est sauvegardée au fil de l'eau */
  const cadre = document.querySelector('.cadre') as HTMLElement;
  cadre.addEventListener('input', sauvegarder);
  cadre.addEventListener('change', sauvegarder);

  restaurer();
</script>
