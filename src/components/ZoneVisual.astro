---
/*
 * Le visuel de la section territoire : la carte officielle de la zone
 * desservie (master 7500×5000 dans assets-source/carte-zone-vestia.png,
 * déclinaisons générées dans public/ — WebP qualité 82 + repli PNG),
 * encadrée dans la même grammaire que les tuiles tarifaires : arrondi
 * commun (--rayon-tuile), filet or 1 px au reflet lent (lumière Vestia,
 * désynchronisé des autres éléments), image bord à bord.
 * Sous la ligne de flottaison : chargement paresseux, dimensions
 * réservées (width/height + aspect-ratio, aucun saut de mise en page).
 */
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const tailles = '(min-width: 64rem) 55vw, 100vw';
const alt =
  'Carte de la zone desservie par Vestia : Griffintown, Cité du Multimédia, Vieux-Montréal et Vieux-Port, entre le canal de Lachine et le fleuve Saint-Laurent';
---

<div class="zone-visuel">
  <picture>
    <source
      type="image/webp"
      srcset={`${base}/carte-zone-vestia-640.webp 640w, ${base}/carte-zone-vestia-1080.webp 1080w, ${base}/carte-zone-vestia-1600.webp 1600w`}
      sizes={tailles}
    />
    <img
      src={`${base}/carte-zone-vestia-1080.png`}
      srcset={`${base}/carte-zone-vestia-640.png 640w, ${base}/carte-zone-vestia-1080.png 1080w, ${base}/carte-zone-vestia-1600.png 1600w`}
      sizes={tailles}
      width="1600"
      height="1067"
      loading="lazy"
      decoding="async"
      alt={alt}
    />
  </picture>
</div>

<style>
  /* La tuile : arrondi commun, image bord à bord clipsée par le conteneur */
  .zone-visuel {
    position: relative;
    border-radius: var(--rayon-tuile);
    overflow: hidden;
  }

  /* Le filet des tuiles tarifaires, au même reflet lent — désynchronisé */
  .zone-visuel::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: var(--rayon-tuile);
    padding: 1px;
    -webkit-mask:
      linear-gradient(#fff 0 0) content-box,
      linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask:
      linear-gradient(#fff 0 0) content-box,
      linear-gradient(#fff 0 0);
    mask-composite: exclude;
    background-image:
      linear-gradient(
        105deg,
        transparent 35%,
        rgba(241, 218, 128, 0.4) 50%,
        transparent 65%
      ),
      linear-gradient(52deg, var(--or-trait) 0%, var(--or-trait) 38%, transparent 80%);
    background-size: 320% 100%, 100% 100%;
    background-position: 130% 0, 0 0;
    animation: lumiere-balayage 12.5s ease-in-out infinite;
    animation-delay: -6s;
    pointer-events: none;
  }

  .zone-visuel img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1600 / 1067;
  }
</style>
