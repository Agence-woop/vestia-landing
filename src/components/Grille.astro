---
import Cta from './Cta.astro';
import { ROUTES, t, type Langue } from '../i18n';
import { formaterMontant } from '../lib/formats';
/* Section 4 — La grille. Trois cartes sobres, prix en or aplat.
   Textes dans src/i18n, montants au format de la langue. */
interface Props {
  langue?: Langue;
}
const { langue = 'fr' } = Astro.props;
const dico = t(langue);
/* En français, l'espace avant le $ est insécable */
const prixAffiche = (n: number) => formaterMontant(n, langue).replace(' $', ' $');
---

<section class="section section--voile" id="grille">
  <div class="section__inner">
    <h2>{dico.grille.titre}</h2>

    <div class="cartes">
      {
        dico.grille.paliers.map((palier) => (
          <article class="carte surface-tuile">
            <p class="titre">
              <span class="pill">{palier.nom}</span> <span class="prix">{prixAffiche(palier.prix)}</span>
            </p>
            <p class="detail">{palier.detail}</p>
          </article>
        ))
      }
    </div>

    <p class="conditions">
      {dico.grille.condition1}<br />{dico.grille.condition2}<br />
      <span class="hors-liste">{dico.grille.horsListe}</span>
    </p>

    <p class="egards">{dico.grille.egards}</p>

    <div class="section__action">
      <Cta href={ROUTES.reserver[langue]}>{dico.hero.cta}</Cta>
    </div>
  </div>
</section>

<style>
  /* Respirations : uniquement l'échelle commune (tokens.css) —
     titre → tuiles comme les autres paires titre → contenu, mentions
     liées un cran en dessous, exclusions un cran au-dessus, CTA généreux */
  .cartes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: var(--espace-bloc-xs);
    margin-top: var(--espace-bloc-md);
  }

  /* En desktop : trois colonnes égales alignées sur les marges de la
     section (même conteneur que le titre), espacement généreux au cran
     supérieur de l'échelle ; hauteur minimale commune — contenu calé en
     haut, l'air respire sous la liste, trois tuiles d'égale hauteur */
  @media (min-width: 64rem) {
    .cartes {
      grid-template-columns: repeat(4, 1fr);
      gap: var(--espace-bloc-md);
    }

    .carte {
      min-height: 16.5rem;
    }
  }

  /* Fond et contour : la surface de tuile commune (sections.css) ; ici,
     seuls le gabarit et la désynchronisation du reflet, carte par carte */
  .carte {
    padding: 1.4rem 1.5rem;
  }

  .carte:nth-child(1)::before {
    animation-delay: -2s;
  }

  .carte:nth-child(2)::before {
    animation-delay: -5.5s;
    animation-duration: 12s;
  }

  .carte:nth-child(3)::before {
    animation-delay: -9s;
    animation-duration: 14s;
  }

  .carte:nth-child(4)::before {
    animation-delay: -11.5s;
    animation-duration: 12s;
  }

  .titre {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    font-weight: 500;
    font-size: 0.92rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  /* Le nom de la pièce en pill ocre, texte nuit pétrole ; le prix reste
     en or, hors de la pill. Lumière Vestia : un balayage subtil glisse
     sur le fond ocre (couches de fond seulement — le texte, peint
     au-dessus, ne change pas). */
  .pill {
    background-image:
      linear-gradient(
        105deg,
        transparent 35%,
        rgba(255, 248, 225, 0.28) 50%,
        transparent 65%
      ),
      linear-gradient(#c4a03c, #c4a03c);
    background-size: 320% 100%, 100% 100%;
    background-position: 130% 0, 0 0;
    color: #091e35;
    padding: 0.35em 0.9em;
    border-radius: 999px;
    text-shadow: none;
    animation: lumiere-balayage 11s ease-in-out infinite;
  }

  .carte:nth-child(2) .pill {
    animation-delay: -3.5s;
  }

  .carte:nth-child(3) .pill {
    animation-delay: -7s;
    animation-duration: 12s;
  }

  .carte:nth-child(4) .pill {
    animation-delay: -9.5s;
    animation-duration: 13s;
  }

  .prix {
    font-family: var(--police-voix);
    color: var(--or-trait);
    /* +3 pt (1,15 rem → 1,4 rem) : lisible d'un coup d'œil, sans effet
       promotionnel — la pill du palier garde la dominance */
    font-size: 1.4rem;
    letter-spacing: 0.04em;
    text-transform: none;
    transition: color var(--duree-theme) ease;
  }

  .detail {
    margin-top: 0.5rem;
    font-size: var(--taille-courant);
    /* Lecture aérée des listes de pièces */
    line-height: 1.9;
    opacity: 0.9;
  }

  .conditions {
    margin-top: var(--espace-bloc-sm);
    text-align: center;
    font-size: 0.93rem;
    letter-spacing: 0.08em;
    opacity: 0.8;
  }

  /* La troisième ligne, même style mais plus discrète */
  .hors-liste {
    opacity: 0.75;
  }

  .egards {
    margin-top: var(--espace-bloc-md);
    text-align: center;
    font-size: 0.9rem;
    line-height: 1.8;
    opacity: 0.8;
    max-width: 62ch;
    margin-inline: auto;
  }
</style>
