---
import Cta from './Cta.astro';
/* Section 4 — La grille. Trois cartes sobres + une carte voilée. Prix en or aplat. */
---

<section class="section section--voile" id="grille">
  <div class="section__inner">
    <h2>La clarté, jusque dans les prix</h2>

    <div class="cartes">
      <article class="carte">
        <p class="titre"><span class="pill">Pièce simple</span> <span class="prix">5&nbsp;$</span></p>
        <p class="detail">Chandail, camisole, legging, vêtement sans structure</p>
      </article>
      <article class="carte">
        <p class="titre"><span class="pill">Pièce standard</span> <span class="prix">8&nbsp;$</span></p>
        <p class="detail">Chemise, blouse, pantalon, jean, jupe, polo</p>
      </article>
      <article class="carte">
        <p class="titre"><span class="pill">Pièce complexe</span> <span class="prix">12&nbsp;$</span></p>
        <p class="detail">Robe, chemise en lin, pièce plissée, veston</p>
      </article>

      <article class="carte carte--voilee">
        <p class="titre">
          <span class="pastille" aria-hidden="true"></span>Bientôt
        </p>
        <p class="detail">Linge de maison · Manteaux &amp; trenchs<br />Le service s'étend.</p>
        <!-- Branché sur Formspree en Mission 4 -->
        <form class="prevenir" data-formulaire="prevenez-moi">
          <label class="visually-hidden" for="courriel-bientot">Votre courriel</label>
          <input
            class="champ"
            type="email"
            id="courriel-bientot"
            name="courriel"
            placeholder="Votre courriel"
            autocomplete="email"
          />
          <button class="btn-secondaire" type="submit">Prévenez-moi</button>
        </form>
      </article>
    </div>

    <p class="conditions">Minimum de 8 pièces<br />Cueillette et livraison toujours incluses</p>

    <p class="egards">
      Nous déclinons avec égards le cachemire, la laine et la maille tricotée, ainsi que les pièces
      de haute couture. Ces étoffes méritent leur propre spécialiste.
    </p>

    <div class="section__action">
      <Cta href="/reserver">Réserver une cueillette</Cta>
    </div>
  </div>
</section>

<style>
  /* Respirations : uniquement l'échelle commune (tokens.css) —
     titre → tuiles comme les autres paires titre → contenu, mentions
     liées un cran en dessous, exclusions un cran au-dessus, CTA généreux */
  .cartes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 1.25rem;
    margin-top: var(--espace-bloc-md);
  }

  /* En desktop : quatre tuiles sur une seule ligne, gap généreux,
     léger débord latéral pour compenser */
  @media (min-width: 64rem) {
    .cartes {
      grid-template-columns: repeat(4, 1fr);
      gap: 1.75rem;
      margin-inline: -1.25rem;
    }
  }

  /* Les cartes parlent le langage du bouton D4 : filet or 1 px en
     dégradé masqué incliné à 52°, l'or vivant en bas-gauche et
     s'éteignant vers le haut-droit */
  .carte {
    position: relative;
    background-color: rgba(16, 45, 76, 0.55);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    border-radius: 1.25rem;
    padding: 1.4rem 1.5rem;
    box-shadow: 0 12px 32px rgba(4, 14, 26, 0.3);
  }

  /* Lumière Vestia : un reflet discret parcourt lentement le contour —
     la bande (première couche) glisse sur le filet masqué, désynchronisée
     d'une carte à l'autre */
  .carte::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 1.25rem;
    padding: 1px;
    -webkit-mask:
      linear-gradient(#fff 0 0) content-box,
      linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask:
      linear-gradient(#fff 0 0) content-box,
      linear-gradient(#fff 0 0);
    mask-composite: exclude;
    background-image:
      linear-gradient(
        105deg,
        transparent 35%,
        rgba(241, 218, 128, 0.4) 50%,
        transparent 65%
      ),
      linear-gradient(52deg, var(--or-trait) 0%, var(--or-trait) 38%, transparent 80%);
    background-size: 320% 100%, 100% 100%;
    background-position: 130% 0, 0 0;
    animation: lumiere-balayage 13s ease-in-out infinite;
    pointer-events: none;
  }

  .carte:nth-child(1)::before {
    animation-delay: -2s;
  }

  .carte:nth-child(2)::before {
    animation-delay: -5.5s;
    animation-duration: 12s;
  }

  .carte:nth-child(3)::before {
    animation-delay: -9s;
    animation-duration: 14s;
  }

  .carte:nth-child(4)::before {
    animation-delay: -11.5s;
  }

  .titre {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    font-weight: 500;
    font-size: 0.92rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  /* Le nom de la pièce en pill ocre, texte nuit pétrole ; le prix reste
     en or, hors de la pill. Lumière Vestia : un balayage subtil glisse
     sur le fond ocre (couches de fond seulement — le texte, peint
     au-dessus, ne change pas). */
  .pill {
    background-image:
      linear-gradient(
        105deg,
        transparent 35%,
        rgba(255, 248, 225, 0.28) 50%,
        transparent 65%
      ),
      linear-gradient(#c4a03c, #c4a03c);
    background-size: 320% 100%, 100% 100%;
    background-position: 130% 0, 0 0;
    color: #091e35;
    padding: 0.35em 0.9em;
    border-radius: 999px;
    text-shadow: none;
    animation: lumiere-balayage 11s ease-in-out infinite;
  }

  .carte:nth-child(2) .pill {
    animation-delay: -3.5s;
  }

  .carte:nth-child(3) .pill {
    animation-delay: -7s;
    animation-duration: 12s;
  }

  .prix {
    font-family: var(--police-voix);
    color: var(--or-trait);
    font-size: 1.15rem;
    letter-spacing: 0.04em;
    text-transform: none;
    transition: color var(--duree-theme) ease;
  }

  .detail {
    margin-top: 0.5rem;
    font-size: var(--taille-courant);
    opacity: 0.9;
  }

  /* ---------- la carte voilée ---------- */
  /* Fond bleu-noir nettement plus sombre : la tuile se distingue
     des trois cartes actives */
  .carte--voilee {
    background-color: rgba(4, 12, 24, 0.72);
  }

  /* Même filet D4, en version plus estompée — même lumière */
  .carte--voilee::before {
    background-image:
      linear-gradient(
        105deg,
        transparent 35%,
        rgba(241, 218, 128, 0.25) 50%,
        transparent 65%
      ),
      linear-gradient(
        52deg,
        rgba(196, 160, 60, 0.45) 0%,
        rgba(196, 160, 60, 0.45) 38%,
        transparent 80%
      );
  }

  .carte--voilee .titre {
    justify-content: flex-start;
    gap: 0.6rem;
    color: var(--or-trait);
    transition: color var(--duree-theme) ease;
  }

  .pastille {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--or-trait);
    align-self: center;
    transition: background-color var(--duree-theme) ease;
  }

  .prevenir {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    align-items: flex-end;
    margin-top: 1.1rem;
  }

  .prevenir .champ {
    flex: 1;
    min-width: 11rem;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .conditions {
    margin-top: var(--espace-bloc-sm);
    text-align: center;
    font-size: 0.93rem;
    letter-spacing: 0.08em;
    opacity: 0.8;
  }

  .egards {
    margin-top: var(--espace-bloc-md);
    text-align: center;
    font-size: 0.9rem;
    line-height: 1.8;
    opacity: 0.8;
    max-width: 62ch;
    margin-inline: auto;
  }
</style>
