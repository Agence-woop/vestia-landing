---
/*
 * Bouton « le trait qui se referme » — variante D4.
 * CSS de référence : assets-source/vestia-boutons-v3.html
 * Filet or 1 px en dégradé masqué incliné à 52°, fondu plus tôt en haut
 * qu'en bas ; au survol/toucher, l'anneau se complète en champagne.
 */
interface Props {
  href: string;
}

const { href } = Astro.props;
---

<a class="cta" href={href}><slot /></a>

<style>
  .cta {
    position: relative;
    display: inline-block;
    padding: 1rem 2.4rem;
    border-radius: 999px;
    color: var(--texte);
    text-decoration: none;
    font-size: 0.83rem;
    letter-spacing: 0.26em;
    margin-right: -0.26em;
    text-transform: uppercase;
    white-space: nowrap;
    transition: color var(--duree-theme) ease;
    -webkit-tap-highlight-color: transparent;
  }

  .cta::before,
  .cta::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 999px;
    padding: 1px;
    -webkit-mask:
      linear-gradient(#fff 0 0) content-box,
      linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask:
      linear-gradient(#fff 0 0) content-box,
      linear-gradient(#fff 0 0);
    mask-composite: exclude;
    pointer-events: none;
    transition: opacity 0.5s ease;
  }

  /* La bordure vivante : l'ouverture du trait dérive lentement le long
     du pourtour. --angle-cta est typée via @property pour être animable ;
     sans support, la boucle 52° → 412° retombe sur le même rendu
     statique (412° ≡ 52°). */
  @property --angle-cta {
    syntax: '<angle>';
    inherits: false;
    initial-value: 52deg;
  }

  .cta::before {
    background: linear-gradient(
      var(--angle-cta, 52deg),
      var(--or-trait) 0%,
      var(--or-trait) 38%,
      transparent 80%
    );
    animation: derive 11s linear infinite;
  }

  @keyframes derive {
    from {
      --angle-cta: 52deg;
    }
    to {
      --angle-cta: 412deg;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cta::before {
      animation: none;
    }
  }

  .cta::after {
    background: linear-gradient(
      90deg,
      var(--or-ferme-a) 0%,
      var(--or-ferme-b) 40%,
      var(--or-ferme-a) 100%
    );
    opacity: 0;
  }

  .cta:hover::after,
  .cta:active::after,
  .cta:focus-visible::after {
    opacity: 1;
  }

  .cta:hover::before,
  .cta:active::before,
  .cta:focus-visible::before {
    opacity: 0;
  }

  .cta:active {
    color: var(--or-ferme-a);
  }
</style>
