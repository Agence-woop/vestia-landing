---
/*
 * Bouton « le trait qui se referme » — variante D4.
 * CSS de référence : assets-source/vestia-boutons-v3.html
 * Filet or 1 px partiellement fondu ; au survol/toucher, l'anneau se
 * complète en champagne. La bordure est vivante : un conic-gradient
 * tourne en continu (transform: rotate) derrière le masque de l'anneau —
 * fiable sur desktop et mobile, contrairement à l'animation d'angle de
 * dégradé via @property.
 */
interface Props {
  href: string;
}

const { href } = Astro.props;
---

<a class="cta" href={href}><span class="filet" aria-hidden="true"></span><slot /></a>

<style>
  .cta {
    position: relative;
    display: inline-block;
    padding: 1rem 2.4rem;
    border-radius: 999px;
    color: var(--texte);
    text-decoration: none;
    font-size: 0.83rem;
    letter-spacing: 0.26em;
    margin-right: -0.26em;
    text-transform: uppercase;
    white-space: nowrap;
    transition: color var(--duree-theme) ease;
    -webkit-tap-highlight-color: transparent;
  }

  /* L'anneau ouvert : le masque ne laisse voir que le filet de 1 px ;
     tout ce qui se dessine dedans (le dégradé tournant) y est confiné */
  .filet {
    position: absolute;
    inset: 0;
    border-radius: 999px;
    padding: 1px;
    -webkit-mask:
      linear-gradient(#fff 0 0) content-box,
      linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask:
      linear-gradient(#fff 0 0) content-box,
      linear-gradient(#fff 0 0);
    mask-composite: exclude;
    pointer-events: none;
    transition: opacity 0.5s ease;
  }

  /* Le dégradé vivant : un carré surdimensionné en conic-gradient tourne
     lentement — l'ouverture du trait dérive le long du pourtour */
  .filet::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 150%;
    aspect-ratio: 1;
    background: conic-gradient(
      from 0deg,
      transparent 15deg,
      var(--or-trait) 100deg,
      var(--or-trait) 250deg,
      transparent 335deg
    );
    transform: translate(-50%, -50%) rotate(0turn);
    animation: tourne 11s linear infinite;
  }

  @keyframes tourne {
    to {
      transform: translate(-50%, -50%) rotate(1turn);
    }
  }

  /* L'anneau refermé en champagne, au survol/toucher */
  .cta::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 999px;
    padding: 1px;
    -webkit-mask:
      linear-gradient(#fff 0 0) content-box,
      linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask:
      linear-gradient(#fff 0 0) content-box,
      linear-gradient(#fff 0 0);
    mask-composite: exclude;
    pointer-events: none;
    transition: opacity 0.5s ease;
    background: linear-gradient(
      90deg,
      var(--or-ferme-a) 0%,
      var(--or-ferme-b) 40%,
      var(--or-ferme-a) 100%
    );
    opacity: 0;
  }

  .cta:hover::after,
  .cta:active::after,
  .cta:focus-visible::after {
    opacity: 1;
  }

  .cta:hover .filet,
  .cta:active .filet,
  .cta:focus-visible .filet {
    opacity: 0;
  }

  .cta:active {
    color: var(--or-ferme-a);
  }

  @media (prefers-reduced-motion: reduce) {
    /* Bordure statique : le dégradé s'immobilise, l'or posé en bas-gauche */
    .filet::before {
      animation: none;
      transform: translate(-50%, -50%) rotate(0.35turn);
    }
  }
</style>
