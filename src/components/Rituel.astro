---
import Cta from './Cta.astro';
import { ROUTES, t, type Langue } from '../i18n';
/* Section 3 — Le rituel. Trois gestes, numérotés en or. Textes dans src/i18n. */
interface Props {
  langue?: Langue;
}
const { langue = 'fr' } = Astro.props;
const dico = t(langue);
const NUMEROS = ['I', 'II', 'III'];
---

<section class="section section--voile section--amorce" id="rituel">
  <div class="section__inner">
    <h2>{dico.rituel.titre}</h2>

    <ol class="gestes">
      {
        dico.rituel.gestes.map((geste, i) => (
          <li>
            <span class="numero" aria-hidden="true">{NUMEROS[i]}</span>
            <div>
              <h3 class="etiquette-or">{geste.titre}</h3>
              <p>{geste.texte}</p>
            </div>
          </li>
        ))
      }
    </ol>

    <div class="section__action">
      <Cta href={ROUTES.reserver[langue]}>{dico.hero.cta}</Cta>
    </div>
  </div>
</section>

<style>
  .gestes {
    list-style: none;
    margin-top: var(--espace-bloc-md);
  }

  .gestes li {
    display: flex;
    align-items: center;
    gap: clamp(1.75rem, 3vw, 3rem);
    padding: 1.5rem 0;
    border-top: 1px solid var(--filet);
  }

  .numero {
    position: relative;
    flex-shrink: 0;
    width: 3.75rem;
    height: 3.75rem;
    border-radius: 50%;
    display: grid;
    place-items: center;
    font-family: var(--police-voix);
    color: var(--or-trait);
    font-size: 1.15rem;
  }

  /* Le pourtour, dans l'esprit du bouton D4 : filet or 1 px fondu
     vers le transparent, le trait s'éteignant vers le haut-droit */
  .numero::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    padding: 1px;
    -webkit-mask:
      linear-gradient(#fff 0 0) content-box,
      linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask:
      linear-gradient(#fff 0 0) content-box,
      linear-gradient(#fff 0 0);
    mask-composite: exclude;
    background: linear-gradient(52deg, var(--or-trait) 0%, var(--or-trait) 38%, transparent 80%);
    pointer-events: none;
  }

  /* Style partagé .etiquette-or (sections.css) ; seul l'espacement est local */
  .gestes h3 {
    margin-bottom: 0.45rem;
  }

  .gestes p {
    opacity: 0.9;
  }
</style>
