---
import Cta from './Cta.astro';
/* Section 3 — Le rituel. Trois gestes, numérotés en or. */
---

<section class="section section--voile section--amorce" id="rituel">
  <div class="section__inner">
    <h2>Le rituel Vestia</h2>

    <ol class="gestes">
      <li>
        <span class="numero" aria-hidden="true">I</span>
        <div>
          <h3>La cueillette</h3>
          <p>
            Choisissez votre créneau. Nous passons à votre porte, comptons chaque pièce avec vous,
            et prenons le relais.
          </p>
        </div>
      </li>
      <li>
        <span class="numero" aria-hidden="true">II</span>
        <div>
          <h3>Le soin</h3>
          <p>
            Chaque vêtement est repassé à la main, un à un, avec la minutie d'un atelier.
          </p>
        </div>
      </li>
      <li>
        <span class="numero" aria-hidden="true">III</span>
        <div>
          <h3>Le retour</h3>
          <p>
            Vos pièces reviennent sur cintre et sous housse de protection, à l'abri jusqu'à votre
            penderie. Cueillies avant 9&nbsp;h, elles rentrent le soir même&nbsp;; sinon, dès le
            lendemain. Un message annonce notre arrivée.
          </p>
        </div>
      </li>
    </ol>

    <div class="section__action">
      <Cta href="/reserver">Réserver une cueillette</Cta>
    </div>
  </div>
</section>

<style>
  .gestes {
    list-style: none;
    margin-top: 1.8rem;
  }

  .gestes li {
    display: flex;
    align-items: center;
    gap: clamp(1.75rem, 3vw, 3rem);
    padding: 1.5rem 0;
    border-top: 1px solid var(--filet);
  }

  .numero {
    position: relative;
    flex-shrink: 0;
    width: 3.75rem;
    height: 3.75rem;
    border-radius: 50%;
    display: grid;
    place-items: center;
    font-family: var(--police-voix);
    color: var(--or-trait);
    font-size: 1.15rem;
  }

  /* Le pourtour, dans l'esprit du bouton D4 : filet or 1 px fondu
     vers le transparent, le trait s'éteignant vers le haut-droit */
  .numero::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    padding: 1px;
    -webkit-mask:
      linear-gradient(#fff 0 0) content-box,
      linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask:
      linear-gradient(#fff 0 0) content-box,
      linear-gradient(#fff 0 0);
    mask-composite: exclude;
    background: linear-gradient(52deg, var(--or-trait) 0%, var(--or-trait) 38%, transparent 80%);
    pointer-events: none;
  }

  .gestes h3 {
    font-family: var(--police-courant);
    font-weight: 500;
    font-size: 0.86rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    margin-bottom: 0.45rem;
    color: var(--or-trait);
  }

  .gestes p {
    opacity: 0.9;
  }
</style>
