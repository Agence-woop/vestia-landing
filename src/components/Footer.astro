---
/*
 * Section 8 — Le pied de page. Discret, complet, sur la soie voilée.
 * Téléphone, courriel et Instagram : décisions du propriétaire en attente
 * (brief §7) — pastilles provisoires à remplacer avant lancement.
 * Mentions légales et politique de confidentialité : pages en Mission 6.
 */
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<footer class="section section--voile">
  <div class="section__inner">
    <p class="nom">Vestia — Services à domicile</p>
    <p class="lieux">Griffintown · Cité du Multimédia · Vieux-Port — Montréal</p>
    <p class="horaires">Du lundi au vendredi</p>

    <p class="contacts">
      <span>Téléphone</span> · <span>Courriel</span> · <span>Instagram</span>
    </p>

    <p class="legal">
      <a href={`${base}/mentions-legales`}>Mentions légales</a> ·
      <a href={`${base}/politique-de-confidentialite`}>Politique de confidentialité</a>
    </p>

    <p class="copyright">© 2026 Vestia</p>
  </div>
</footer>

<style>
  .section {
    text-align: center;
    padding-top: 3rem;
    padding-bottom: 3.2rem;
  }

  .nom {
    font-size: 0.78rem;
    letter-spacing: 0.3em;
    margin-right: -0.3em;
    text-transform: uppercase;
    opacity: 0.9;
  }

  .lieux {
    margin-top: 0.7rem;
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    opacity: 0.8;
  }

  .horaires {
    margin-top: 0.7rem;
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    opacity: 0.8;
  }

  .contacts {
    margin-top: 1.6rem;
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    opacity: 0.8;
  }

  .legal {
    margin-top: 1.6rem;
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    opacity: 0.8;
  }

  .legal a {
    text-decoration: none;
    border-bottom: 1px solid var(--filet);
    padding-bottom: 0.1rem;
    transition: border-color var(--duree-theme) ease;
  }

  .legal a:hover,
  .legal a:focus-visible {
    border-bottom-color: var(--or-trait);
  }

  .copyright {
    margin-top: 1.6rem;
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    opacity: 0.8;
  }
</style>
