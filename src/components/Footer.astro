---
/*
 * Section 8 — Le pied de page. Discret, complet, sur la soie voilée.
 * Téléphone et courriel : coordonnées réelles, cliquables (tel:/mailto:).
 * Instagram : en attente du compte actif (brief §7).
 * Conditions d'utilisation et politique de confidentialité : pages réelles.
 */
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<footer class="section section--voile">
  <div class="section__inner">
    <p class="nom">Vestia — Repassage · Cueillette à domicile</p>
    <p class="lieux">Griffintown · Cité du Multimédia · Vieux-Montréal</p>
    <p class="horaires">Du lundi au vendredi</p>

    <!-- Instagram reviendra quand le compte sera actif -->
    <p class="contacts">
      <a href="tel:+14383007410">(438)&nbsp;300-7410</a> ·
      <a href="mailto:info@vestia.ca">info@vestia.ca</a>
    </p>

    <p class="legal">
      <span>© 2026 Vestia</span> ·
      <a href={`${base}/conditions-utilisation`}>Conditions d'utilisation</a> ·
      <a href={`${base}/politique-de-confidentialite`}>Politique de confidentialité</a> ·
      <!-- Brancher sur le gestionnaire de témoins lors de son intégration -->
      <a href="#">Gérer les témoins</a>
    </p>
  </div>
</footer>

<style>
  .section {
    text-align: center;
    padding-top: 3rem;
    padding-bottom: 3.2rem;
  }

  .nom {
    font-size: 0.78rem;
    letter-spacing: 0.3em;
    margin-right: -0.3em;
    text-transform: uppercase;
    opacity: 0.9;
  }

  .lieux {
    margin-top: 0.7rem;
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    opacity: 0.8;
  }

  .horaires {
    margin-top: 0.7rem;
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    opacity: 0.8;
  }

  .contacts {
    margin-top: 1.6rem;
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    opacity: 0.8;
    /* En mobile, numéro et courriel peuvent passer sur deux lignes */
    line-height: 2;
  }

  /* Les coordonnées, au style des liens légaux */
  .contacts a {
    text-decoration: none;
    border-bottom: 1px solid var(--filet);
    padding-bottom: 0.1rem;
    transition: border-color var(--duree-theme) ease;
  }

  .contacts a:hover,
  .contacts a:focus-visible {
    border-bottom-color: var(--or-trait);
  }

  /* La ligne peut passer sur deux lignes proprement en mobile */
  .legal {
    margin-top: 1.6rem;
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    opacity: 0.8;
    line-height: 2;
  }

  .legal a {
    text-decoration: none;
    border-bottom: 1px solid var(--filet);
    padding-bottom: 0.1rem;
    transition: border-color var(--duree-theme) ease;
  }

  .legal a:hover,
  .legal a:focus-visible {
    border-bottom-color: var(--or-trait);
  }
</style>
