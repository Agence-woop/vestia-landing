---
import Cta from './Cta.astro';

/*
 * Mission 1 — Le hero et la soie.
 * La soie vidéo couvre l'écran en fond fixe ; le défilement pilote
 * `currentTime` sur toute la hauteur de page (scroll-scrubbing).
 * Replis : lecture en boucle simple si la page ne défile pas encore,
 * si le scrubbing manque de fluidité, ou sans JavaScript ;
 * image fixe si `prefers-reduced-motion`.
 * La soie reste nuit pétrole dans les deux thèmes.
 */
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<div class="soie" aria-hidden="true">
  <video
    id="soie-video"
    muted
    playsinline
    autoplay
    loop
    preload="auto"
    poster={`${base}/soie-poster.jpg`}
  >
    <source src={`${base}/soie-nuit-petrole.mp4`} type="video/mp4" />
  </video>
  <div class="scrim"></div>
</div>

<section class="hero">
  <p class="kicker">Repassage · Cueillette à domicile</p>
  <h1 class="wordmark" data-text="Vestia">Vestia</h1>
  <p class="tagline">L'intendance de votre quotidien</p>
  <div class="action">
    <Cta href="/reserver">Réserver une cueillette</Cta>
  </div>
  <p class="quartiers">Griffintown · Cité du Multimédia · Vieux-Montréal</p>
  <div class="indicateur" aria-hidden="true"></div>
</section>

<style>
  /* ---------- la soie ---------- */
  .soie {
    position: fixed;
    inset: 0;
    z-index: -1;
    background-color: #091e35;
  }

  .soie video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .scrim {
    position: absolute;
    inset: 0;
    background-image: linear-gradient(
      180deg,
      rgba(9, 30, 53, 0.55) 0%,
      rgba(9, 30, 53, 0.18) 32%,
      rgba(9, 30, 53, 0.18) 62%,
      rgba(9, 30, 53, 0.6) 100%
    );
  }

  /* ---------- le hero ---------- */
  .hero {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 2rem;
    color: #faf7f0;
  }

  .kicker {
    opacity: 0.8;
    font-size: 0.8rem;
    letter-spacing: 0.35em;
    margin-right: -0.35em;
    text-transform: uppercase;
    margin-bottom: 2.2rem;
    white-space: nowrap;
  }

  /* Le descripteur tient sur une ligne en mobile : tracking resserré
     pour ce seul élément */
  @media (max-width: 40rem) {
    .kicker {
      letter-spacing: 0.2em;
      margin-right: -0.2em;
    }
  }

  .wordmark {
    position: relative;
    font-family: var(--police-embleme);
    font-weight: 400;
    text-transform: uppercase;
    font-size: clamp(4.4rem, 19.5vw, 10.5rem);
    letter-spacing: 0.2em;
    margin-right: -0.2em;
    background-image: linear-gradient(
      168deg,
      #8e7429 0%,
      #c4a03c 26%,
      #f1da80 50%,
      #c4a03c 74%,
      #8e7429 100%
    );
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  /* Le reflet balayant de l'emblème — la référence « lumière Vestia » :
     bande large aux bords fondus, traversée lente (~3,4 s), pause
     naturelle, aucun saut d'opacité. La lumière révèle le relief du
     champagne, elle n'éblouit pas. */
  .wordmark::after {
    content: attr(data-text);
    position: absolute;
    inset: 0;
    background-image: linear-gradient(
      105deg,
      transparent 25%,
      rgba(255, 248, 225, 0.12) 38%,
      rgba(255, 248, 225, 0.55) 50%,
      rgba(255, 248, 225, 0.12) 62%,
      transparent 75%
    );
    background-size: 320% 100%;
    background-position: 130% 0;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: lumiere-balayage 10s ease-in-out infinite;
  }

  .tagline {
    margin-top: 1.1rem;
    font-size: clamp(0.72rem, 2.8vw, 0.95rem);
    letter-spacing: 0.42em;
    margin-right: -0.42em;
    text-transform: uppercase;
    line-height: 2;
  }

  .action {
    margin-top: 2.6rem;
  }

  /* Sur la soie, le bouton garde l'ivoire dans les deux thèmes */
  .action :global(.cta) {
    color: #faf7f0;
  }

  .quartiers {
    margin-top: 2.4rem;
    font-size: 0.95rem;
    letter-spacing: 0.12em;
    opacity: 0.8;
  }

  .hero {
    position: relative;
  }

  /* L'indicateur de scroll : une goutte de lumière qui coule, sans
     support apparent — aucun rail visible, seul le segment d'or passe. */
  .indicateur {
    position: absolute;
    bottom: 1.6rem;
    left: 50%;
    transform: translateX(-50%);
    width: 2px;
    height: 92px;
    overflow: hidden;
    pointer-events: none;
  }

  .indicateur::after {
    content: '';
    position: absolute;
    inset: 0 auto auto 0;
    width: 100%;
    height: 30%;
    background: linear-gradient(
      180deg,
      transparent 0%,
      #c4a03c 35%,
      #f1da80 65%,
      transparent 100%
    );
    animation: goutte 6.5s ease-in-out infinite;
  }

  /* Une respiration : la goutte glisse calmement, s'évanouit,
     marque une courte pause, puis renaît en haut */
  @keyframes goutte {
    0% {
      transform: translateY(-100%);
      opacity: 0;
    }
    12% {
      opacity: 1;
    }
    80% {
      opacity: 1;
    }
    92% {
      transform: translateY(330%);
      opacity: 0;
    }
    100% {
      transform: translateY(330%);
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .wordmark::after {
      animation: none;
      content: none;
    }

    /* Goutte immobile et discrète, posée au centre du parcours */
    .indicateur::after {
      animation: none;
      transform: translateY(115%);
      opacity: 0.45;
    }
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  const video = document.getElementById('soie-video') as HTMLVideoElement | null;

  if (video) {
    const mouvementReduit = matchMedia('(prefers-reduced-motion: reduce)');

    const enBoucle = () => {
      video.loop = true;
      video.play().catch(() => {});
    };

    const demarrer = () => {
      /* Image fixe pour qui préfère un mouvement réduit */
      if (mouvementReduit.matches) {
        video.pause();
        video.currentTime = 0;
        return;
      }

      /* Tant que la page ne défile pas, la soie ondule en boucle simple */
      const portee = document.documentElement.scrollHeight - window.innerHeight;
      if (portee < 200) {
        enBoucle();
        return;
      }

      /* Scroll-scrubbing : le défilement pilote currentTime sur toute la page */
      video.loop = false;
      /* Un aller-retour lecture/pause force le décodage sur iOS */
      video.play().then(() => video.pause()).catch(() => {});

      gsap.registerPlugin(ScrollTrigger);
      const scrub = gsap.to(video, {
        currentTime: video.duration,
        ease: 'none',
        scrollTrigger: {
          trigger: document.body,
          start: 'top top',
          end: 'bottom bottom',
          scrub: 0.5,
        },
      });

      /* Repli : si les seeks sont trop lents (mobile bas de gamme), boucle simple */
      let debutSeek = 0;
      let cumul = 0;
      let mesures = 0;
      video.addEventListener('seeking', () => {
        debutSeek = performance.now();
      });
      video.addEventListener('seeked', () => {
        cumul += performance.now() - debutSeek;
        mesures += 1;
        if (mesures >= 12 && cumul / mesures > 200) {
          scrub.scrollTrigger?.kill();
          scrub.kill();
          enBoucle();
        }
      });
    };

    if (video.readyState >= 1) {
      demarrer();
    } else {
      video.addEventListener('loadedmetadata', demarrer, { once: true });
    }
  }
</script>
