---
/*
 * La soie — le fond commun du site : vidéo nuit pétrole en fond fixe,
 * voile assombrissant, et scroll-scrubbing (le défilement pilote
 * currentTime sur toute la hauteur de page). Extraite du hero pour être
 * partagée par l'accueil, /reserver et les pages légales — une seule
 * logique.
 * Replis : lecture en boucle simple si la page ne défile pas, si les
 * seeks manquent de fluidité, ou sans JavaScript ; image fixe (affiche)
 * si prefers-reduced-motion. Le poster s'affiche immédiatement : la
 * vidéo ne retarde jamais le texte.
 */
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<div class="soie" aria-hidden="true">
  <!-- Une seule vidéo est téléchargée : la source portrait pour les
       écrans mobiles, la source desktop 16:9 pour les écrans larges -->
  <video
    id="soie-video"
    muted
    playsinline
    webkit-playsinline
    autoplay
    loop
    preload="auto"
    disableremoteplayback
  >
    <source
      src={`${base}/soie-nuit-petrole-mobile.mp4`}
      type="video/mp4"
      media="(orientation: portrait)"
    />
    <source src={`${base}/soie-nuit-petrole.mp4`} type="video/mp4" />
  </video>
  <div class="scrim"></div>
</div>

<!-- L'affiche suit le format servi ; posée ici en synchrone pour
     qu'une seule des deux images soit jamais demandée. WebP q80 tirée
     de la première image de chaque soie : vidéo en pause = même image
     nuit pétrole, sans rupture. -->
<script is:inline define:vars={{ base }}>
  document.getElementById('soie-video').poster = matchMedia('(orientation: portrait)').matches
    ? `${base}/soie-poster-mobile.webp`
    : `${base}/soie-poster.webp`;
</script>

<style>
  .soie {
    position: fixed;
    inset: 0;
    z-index: -1;
    background-color: #091e35;
  }

  .soie video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* La soie est un fond : aucune interaction directe possible */
    pointer-events: none;
  }

  /* iOS : quand l'économie d'énergie bloque l'autoplay, Safari pose son
     bouton de lecture natif par-dessus la vidéo — on masque ces
     contrôles WebKit, pour la soie seulement */
  .soie video::-webkit-media-controls,
  .soie video::-webkit-media-controls-start-playback-button,
  .soie video::-webkit-media-controls-overlay-play-button {
    display: none !important;
    -webkit-appearance: none;
    opacity: 0;
  }

  /* Le voile assombrissant qui garantit le contraste du texte */
  .scrim {
    position: absolute;
    inset: 0;
    background-image: linear-gradient(
      180deg,
      rgba(9, 30, 53, 0.55) 0%,
      rgba(9, 30, 53, 0.18) 32%,
      rgba(9, 30, 53, 0.18) 62%,
      rgba(9, 30, 53, 0.6) 100%
    );
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  const video = document.getElementById('soie-video') as HTMLVideoElement | null;

  if (video) {
    const mouvementReduit = matchMedia('(prefers-reduced-motion: reduce)');
    /* Vrai quand le défilement pilote la vidéo : une relance de lecture
       doit alors re-pauser aussitôt (le play ne sert qu'à décoder) */
    let modeScrub = false;

    const enBoucle = () => {
      modeScrub = false;
      video.loop = true;
      /* Sur les pages trop courtes pour le scrubbing, la boucle est
         ralentie en respiration à peine perceptible : le mouvement ne
         distrait pas la saisie (parcours de réservation, entre autres) */
      video.playbackRate = 0.4;
      video.play().catch(() => {});
    };

    const demarrer = () => {
      /* Image fixe pour qui préfère un mouvement réduit */
      if (mouvementReduit.matches) {
        video.pause();
        video.currentTime = 0;
        return;
      }

      /* Tant que la page ne défile pas, la soie ondule en boucle simple */
      const portee = document.documentElement.scrollHeight - window.innerHeight;
      if (portee < 200) {
        enBoucle();
        return;
      }

      /* Scroll-scrubbing : le défilement pilote currentTime sur toute la page */
      modeScrub = true;
      video.loop = false;
      /* Un aller-retour lecture/pause force le décodage sur iOS */
      video.play().then(() => video.pause()).catch(() => {});

      gsap.registerPlugin(ScrollTrigger);
      const scrub = gsap.to(video, {
        currentTime: video.duration,
        ease: 'none',
        scrollTrigger: {
          trigger: document.body,
          start: 'top top',
          end: 'bottom bottom',
          scrub: 0.5,
        },
      });

      /* Repli : si les seeks sont trop lents (mobile bas de gamme), boucle simple */
      let debutSeek = 0;
      let cumul = 0;
      let mesures = 0;
      video.addEventListener('seeking', () => {
        debutSeek = performance.now();
      });
      video.addEventListener('seeked', () => {
        cumul += performance.now() - debutSeek;
        mesures += 1;
        if (mesures >= 12 && cumul / mesures > 200) {
          scrub.scrollTrigger?.kill();
          scrub.kill();
          enBoucle();
        }
      });
    };

    if (video.readyState >= 1) {
      demarrer();
    } else {
      video.addEventListener('loadedmetadata', demarrer, { once: true });
    }

    /* Relance après un refus d'autoplay (iOS en économie d'énergie) :
       tentative silencieuse à la première interaction ou au retour
       d'onglet ; les écouteurs se retirent dès que la lecture reprend.
       En mouvement réduit, l'image reste volontairement fixe. */
    const retirerRelance = () => {
      window.removeEventListener('touchstart', relance);
      window.removeEventListener('click', relance);
      document.removeEventListener('visibilitychange', relance);
    };
    const relance = () => {
      if (mouvementReduit.matches) {
        retirerRelance();
        return;
      }
      if (document.visibilityState === 'hidden') return;
      /* Lecture déjà en cours : plus rien à relancer */
      if (!video.paused) {
        retirerRelance();
        return;
      }
      const tentative = video.play();
      if (tentative) {
        tentative
          .then(() => {
            if (modeScrub) video.pause();
            retirerRelance();
          })
          .catch(() => {});
      }
    };
    window.addEventListener('touchstart', relance, { passive: true });
    window.addEventListener('click', relance, { passive: true });
    document.addEventListener('visibilitychange', relance);
  }
</script>
