---
import Sceau from './Sceau.astro';
import { t, type Langue } from '../i18n';

/*
 * Section 6 — Les engagements. Un contrat signé : les trois clauses aux
 * filets d'or à gauche, le sceau de maison à droite (desktop seulement),
 * la contresignature sous la dernière clause. Textes dans src/i18n.
 */
interface Props {
  langue?: Langue;
}
const { langue = 'fr' } = Astro.props;
const dico = t(langue).engagements;

/* Sceau en évaluation — passer à false pour le retirer */
const showSeal = true;
---

<section class="section section--voile" id="engagements">
  <div class="section__inner deux-colonnes">
    <div class="clauses">
      <h2>{dico.titre}</h2>

      <ul class="engagements">
        {
          dico.clauses.map((clause) => (
            <li>
              <h3 class="etiquette-or">{clause.titre}</h3>
              <p>{clause.texte}</p>
            </li>
          ))
        }
      </ul>

      <p class="signature">— <span class="griffe">Vestia</span></p>
    </div>

    {showSeal && <Sceau />}
  </div>
</section>

<style>
  .deux-colonnes {
    display: grid;
    gap: clamp(2rem, 4vw, 4rem);
  }

  /* Deux colonnes en desktop : les clauses (~58 %), le sceau (~42 %)
     centré verticalement ; en mobile le sceau est masqué — les clauses
     et la signature suffisent */
  .deux-colonnes :global(.sceau) {
    display: none;
  }

  @media (min-width: 64rem) {
    .deux-colonnes {
      grid-template-columns: minmax(0, 58fr) minmax(0, 42fr);
      align-items: center;
    }

    .deux-colonnes :global(.sceau) {
      display: block;
      justify-self: center;
    }
  }

  .engagements {
    list-style: none;
    margin-top: var(--espace-bloc-md);
    max-width: 46rem;
  }

  .engagements li {
    padding: 1.3rem 0;
    border-top: 1px solid rgba(196, 160, 60, 0.35);
  }

  .engagements li:last-child {
    border-bottom: 1px solid rgba(196, 160, 60, 0.35);
  }

  /* Style partagé .etiquette-or (sections.css) ; seul l'espacement est local */
  .engagements h3 {
    margin-bottom: 0.5rem;
  }

  .engagements p {
    opacity: 0.9;
  }

  /* La contresignature — elle conclut, elle ne colle pas */
  .signature {
    margin-top: var(--espace-bloc-lg);
  }

  /* Le nom en Bodoni Moda, petites majuscules espacées, champagne
     statique : une signature ne clignote pas */
  .griffe {
    font-family: var(--police-embleme);
    font-weight: 400;
    text-transform: uppercase;
    font-size: 1.25rem;
    letter-spacing: 0.35em;
    margin-left: 0.4rem;
    background-image: linear-gradient(
      168deg,
      #8e7429 0%,
      #c4a03c 26%,
      #f1da80 50%,
      #c4a03c 74%,
      #8e7429 100%
    );
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    text-shadow: none;
  }
</style>
