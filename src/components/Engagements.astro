---
import Sceau from './Sceau.astro';

/*
 * Section 6 — Les engagements. Un contrat signé : les trois clauses aux
 * filets d'or à gauche, le sceau de maison à droite (desktop seulement),
 * la contresignature sous la dernière clause.
 */

/* Sceau en évaluation — passer à false pour le retirer */
const showSeal = true;
---

<section class="section section--voile" id="engagements">
  <div class="section__inner deux-colonnes">
    <div class="clauses">
      <h2>Ce que Vestia vous doit</h2>

      <ul class="engagements">
        <li>
          <h3>Compté, contresigné.</h3>
          <p>
            Chaque pièce est comptée avec vous à la cueillette, recomptée avec vous au retour.
          </p>
        </li>
        <li>
          <h3>Le soir même ou le lendemain.</h3>
          <p>
            Cueillette avant 9&nbsp;h&nbsp;: retour le soir même. Votre créneau est un rendez-vous,
            pas une estimation.
          </p>
        </li>
        <li>
          <h3>Payez à la livraison.</h3>
          <p>
            Virement Interac une fois vos vêtements rendus. Aucune carte, aucun prépaiement, aucune
            surprise.
          </p>
        </li>
      </ul>

      <p class="signature">— <span class="griffe">Vestia</span></p>
    </div>

    {showSeal && <Sceau />}
  </div>
</section>

<style>
  .deux-colonnes {
    display: grid;
    gap: clamp(2rem, 4vw, 4rem);
  }

  /* Deux colonnes en desktop : les clauses (~58 %), le sceau (~42 %)
     centré verticalement ; en mobile le sceau est masqué — les clauses
     et la signature suffisent */
  .deux-colonnes :global(.sceau) {
    display: none;
  }

  @media (min-width: 64rem) {
    .deux-colonnes {
      grid-template-columns: minmax(0, 58fr) minmax(0, 42fr);
      align-items: center;
    }

    .deux-colonnes :global(.sceau) {
      display: block;
      justify-self: center;
    }
  }

  .engagements {
    list-style: none;
    margin-top: var(--espace-bloc-md);
    max-width: 46rem;
  }

  .engagements li {
    padding: 1.3rem 0;
    border-top: 1px solid rgba(196, 160, 60, 0.35);
  }

  .engagements li:last-child {
    border-bottom: 1px solid rgba(196, 160, 60, 0.35);
  }

  .engagements h3 {
    font-size: 1.2rem;
    margin-bottom: 0.5rem;
  }

  .engagements p {
    opacity: 0.9;
  }

  /* La contresignature — elle conclut, elle ne colle pas */
  .signature {
    margin-top: var(--espace-bloc-lg);
  }

  /* Le nom en Bodoni Moda, petites majuscules espacées, champagne
     statique : une signature ne clignote pas */
  .griffe {
    font-family: var(--police-embleme);
    font-weight: 400;
    text-transform: uppercase;
    font-size: 1.25rem;
    letter-spacing: 0.35em;
    margin-left: 0.4rem;
    background-image: linear-gradient(
      168deg,
      #8e7429 0%,
      #c4a03c 26%,
      #f1da80 50%,
      #c4a03c 74%,
      #8e7429 100%
    );
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    text-shadow: none;
  }
</style>
