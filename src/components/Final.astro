---
import Cta from './Cta.astro';
/* Section 7 — Le final. Deux mots, un bouton, sur la soie parfaitement
   tendue — aboutissement du scroll-scrubbing. */
---

<section class="section" id="final">
  <div class="section__inner">
    <h2 class="mot">Prêt-à-porter.</h2>
    <div class="section__action">
      <Cta href="/reserver">Réserver une cueillette</Cta>
    </div>
  </div>
</section>

<style>
  .section {
    display: flex;
    align-items: center;
    min-height: 92svh;
    text-align: center;
  }

  .mot {
    font-size: clamp(3.6rem, 9.75vw, 6.3rem);
    margin-bottom: 0;
  }
</style>
