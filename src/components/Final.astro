---
import Cta from './Cta.astro';
/* Section 7 — Le final. Deux mots, un bouton, sur la soie parfaitement
   tendue — aboutissement du scroll-scrubbing. */
---

<section class="section" id="final">
  <div class="section__inner">
    <h2 class="mot">Prêt-à-porter.</h2>
    <div class="section__action">
      <Cta href="/reserver">Réserver une cueillette</Cta>
    </div>
  </div>
</section>

<style>
  /* Densité : les respirations au-dessus et en dessous du contenu sont
     réduites de moitié (padding et hauteur de centrage divisés par deux) */
  .section {
    display: flex;
    align-items: center;
    min-height: 46svh;
    padding-block: calc(var(--espace-section) / 2);
    text-align: center;
  }

  .mot {
    font-size: clamp(3.6rem, 9.75vw, 6.3rem);
    margin-bottom: 0;
  }

  /* Mobile : « Prêt-à-porter. » tient sur une seule ligne, point final
     compris — taille fluide bornée, calibrée pour 320 px avec le padding
     latéral existant (texte Baskerville ≈ 5,3 × corps) ; à 640 px le
     plafond rejoint exactement la taille desktop, sans saut de règle */
  @media (max-width: 40rem) {
    /* L'item flex, sinon élargi au max-content du CTA (~341 px),
       décalait le centrage sous ~350 px : borné à la largeur
       disponible, titre et bouton se centrent sur le viewport */
    .section__inner {
      max-width: 100%;
    }

    .mot {
      white-space: nowrap;
      font-size: clamp(3rem, 11vw, 3.6rem);
    }
  }
</style>
