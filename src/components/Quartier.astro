---
import Cta from './Cta.astro';
import ZoneVisual from './ZoneVisual.astro';

/*
 * Section 5 — Le territoire. Deux colonnes en desktop : le propos et le
 * vérificateur à gauche, un slot visuel (ZoneVisual, à venir) à droite.
 * Le vérificateur répond côté client, sans envoi serveur : normalisation
 * de la saisie, format canadien, validation par RTA contre
 * src/data/zones.json. Seul l'envoi « Prévenez-moi » (hors zone) part
 * vers Formspree, avec le code postal saisi pour cartographier la
 * demande par quartier. Textes dans src/i18n.
 */
import { ROUTES, t, type Langue } from '../i18n';

interface Props {
  langue?: Langue;
}
const { langue = 'fr' } = Astro.props;
const dico = t(langue).quartier;
---

<section class="section section--voile" id="quartier">
  <div class="section__inner deux-colonnes">
    <!-- En mobile, le visuel (quand il existera) passe au-dessus du texte
         via `order` ; en desktop il occupe la colonne droite -->
    <div class="colonne-texte">
      <h2>{dico.titre}</h2>

      <p class="propos">{dico.propos1}</p>
      <p class="propos">{dico.propos2}</p>

      <form class="verificateur" id="verificateur" novalidate>
        <label class="etiquette" for="code-postal">{dico.etiquetteCodePostal}</label>
        <div class="saisie">
          <input
            class="champ"
            type="text"
            id="code-postal"
            name="code-postal"
            autocomplete="postal-code"
            maxlength="7"
            placeholder="H3C 1A1"
          />
          <Cta type="submit">{dico.verifier}</Cta>
        </div>
      </form>

      <div class="resultat" aria-live="polite">
        <p class="message message--erreur" hidden>{dico.erreurCodePostal}</p>

        <div class="message message--desservi" hidden>
          <p class="dore">{dico.desservi}</p>
          <div class="action">
            <Cta href={ROUTES.reserver[langue]}>{t(langue).hero.cta}</Cta>
          </div>
        </div>

        <div class="message message--hors-zone" hidden>
          <p class="promesse">{dico.promesse}</p>
          <form class="prevenir" id="prevenir-quartier" novalidate>
            <input type="hidden" name="code_postal" id="prevenir-code-postal" />
            <label class="visually-hidden" for="courriel-quartier">{dico.votreCourriel}</label>
            <input
              class="champ"
              type="email"
              id="courriel-quartier"
              name="courriel"
              placeholder={dico.votreCourriel}
              autocomplete="email"
              required
            />
            <button class="btn-secondaire" type="submit">{dico.prevenezMoi}</button>
          </form>
          <p class="suite" hidden></p>
        </div>
      </div>
    </div>

    <ZoneVisual langue={langue} />
  </div>
</section>

<style>
  .deux-colonnes {
    display: grid;
    gap: clamp(2rem, 4vw, 4rem);
  }

  /* Deux colonnes en desktop : le texte (~45 %) à gauche, la carte
     (~55 %) à droite, alignées verticalement */
  @media (min-width: 64rem) {
    .deux-colonnes {
      grid-template-columns: minmax(0, 45fr) minmax(0, 55fr);
      align-items: center;
    }

    .deux-colonnes :global(.zone-visuel) {
      grid-column: 2;
    }
  }

  /* En mobile, la section s'ouvre sur son titre comme les autres, et la
     carte s'intercale entre les paragraphes et le vérificateur — une
     confirmation visuelle juste avant la saisie du code postal.
     display: contents fait des enfants de la colonne texte des items de
     la grille, réordonnés par `order` sans toucher au DOM ; le gap de
     grille est neutralisé au profit des marges propres des blocs.
     Portée mobile seulement (≤ 480 px) : la tablette garde l'ordre
     actuel, carte en tête. */
  @media (max-width: 30rem) {
    .deux-colonnes {
      gap: 0;
    }

    .colonne-texte {
      display: contents;
    }

    .deux-colonnes :global(.zone-visuel) {
      order: 1;
      margin-top: var(--espace-bloc-md);
    }

    .verificateur {
      order: 2;
    }

    .resultat {
      order: 3;
    }
  }

  /* Tablette (au-delà de 480 px, sous la grille desktop) : l'ordre
     d'avant est conservé — la carte passe en tête de la colonne */
  @media (min-width: 30.0625rem) and (max-width: 63.9375rem) {
    .deux-colonnes :global(.zone-visuel) {
      order: -1;
    }
  }

  .propos {
    max-width: 62ch;
  }

  .propos + .propos {
    margin-top: var(--espace-bloc-xs);
  }

  /* ---------- le vérificateur ---------- */
  .verificateur {
    margin-top: var(--espace-bloc-lg);
    max-width: 30rem;
  }

  .etiquette {
    display: block;
    font-size: 0.68rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--or-trait);
    margin-bottom: 0.5rem;
  }

  .saisie {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: flex-end;
  }

  .saisie .champ {
    flex: 1;
    min-width: 9rem;
  }

  /* ---------- les réponses ---------- */
  .resultat {
    max-width: 30rem;
  }

  .message {
    overflow: hidden;
    max-height: 0;
    opacity: 0;
    transform: translateY(0.3rem);
    transition:
      max-height 0.5s ease,
      opacity 0.5s ease,
      transform 0.5s ease;
  }

  .message.visible {
    max-height: 18rem;
    opacity: 1;
    transform: none;
  }

  .message--erreur {
    margin-top: 1rem;
    font-size: 0.95rem;
    color: var(--erreur);
    opacity: 0;
  }

  .message--erreur.visible {
    opacity: 0.9;
  }

  .dore {
    margin-top: 1.4rem;
    font-family: var(--police-voix);
    font-size: 1.15rem;
    color: var(--or-trait);
  }

  .action {
    margin-top: 1.2rem;
    padding-bottom: 0.3rem;
  }

  .promesse {
    margin-top: 1.4rem;
    max-width: 52ch;
  }

  .prevenir {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    align-items: flex-end;
    margin-top: 1rem;
    padding-bottom: 0.2rem;
  }

  .prevenir .champ {
    flex: 1;
    min-width: 11rem;
  }

  .suite {
    margin-top: 0.8rem;
    font-size: 0.95rem;
  }

  /* La suite porte aussi les messages de validation du « Prévenez-moi » */
  .suite.suite--erreur {
    color: var(--erreur);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
</style>

<script>
  import zones from '../data/zones.json';
  import { langueDePage, t } from '../i18n';

  /* ----------------------------------------------------------------
     Endpoint Formspree — liste d'attente (« Prévenez-moi »), le même
     que le bloc hors zone de /reserver. Isolé ici volontairement.
  ---------------------------------------------------------------- */
  const FORMSPREE_PREVENEZ_MOI = 'https://formspree.io/f/mdeoaqoy';

  /* Messages dans la langue de la page (portée par <html lang>) */
  const LANGUE = langueDePage();
  const DICO = t(LANGUE).quartier;

  const verificateur = document.getElementById('verificateur') as HTMLFormElement | null;
  const champ = document.getElementById('code-postal') as HTMLInputElement | null;
  const erreur = document.querySelector('.message--erreur') as HTMLElement | null;
  const desservi = document.querySelector('.message--desservi') as HTMLElement | null;
  const horsZone = document.querySelector('.message--hors-zone') as HTMLElement | null;
  const prevenir = document.getElementById('prevenir-quartier') as HTMLFormElement | null;
  const prevenirCode = document.getElementById('prevenir-code-postal') as HTMLInputElement | null;
  const suite = document.querySelector('.message--hors-zone .suite') as HTMLElement | null;

  const messages = [erreur, desservi, horsZone].filter(Boolean) as HTMLElement[];

  const montrer = (el: HTMLElement) => {
    el.hidden = false;
    requestAnimationFrame(() => requestAnimationFrame(() => el.classList.add('visible')));
  };

  const masquer = (el: HTMLElement) => {
    el.classList.remove('visible');
    el.hidden = true;
  };

  if (verificateur && champ) {
    verificateur.addEventListener('submit', (evenement) => {
      evenement.preventDefault();
      messages.forEach(masquer);

      /* Normalisation : majuscules, espaces et traits d'union retirés */
      const code = champ.value.toUpperCase().replace(/[\s-]/g, '');
      champ.value = code.length > 3 ? `${code.slice(0, 3)} ${code.slice(3)}` : code;

      /* Format canadien : lettre-chiffre-lettre chiffre-lettre-chiffre */
      if (!/^[A-Z]\d[A-Z]\d[A-Z]\d$/.test(code)) {
        if (erreur) montrer(erreur);
        return;
      }

      /* Validation par RTA (3 premiers caractères) contre la liste embarquée */
      if (zones.rta.includes(code.slice(0, 3))) {
        if (desservi) montrer(desservi);
      } else {
        if (prevenirCode) prevenirCode.value = `${code.slice(0, 3)} ${code.slice(3)}`;
        if (horsZone) montrer(horsZone);
      }
    });
  }

  if (prevenir && suite) {
    prevenir.addEventListener('submit', async (evenement) => {
      evenement.preventDefault();
      const saisie = new FormData(prevenir);
      const courriel = String(saisie.get('courriel') ?? '').trim();
      if (!courriel || !courriel.includes('@')) {
        suite.textContent = DICO.erreurCourriel;
        suite.classList.add('suite--erreur');
        suite.hidden = false;
        return;
      }
      /* Noms de champs lisibles tels quels dans le courriel, objet en
         majuscules, réponse directe au client ; la langue choisie
         voyage en champ caché pour le suivi */
      const donnees = new FormData();
      donnees.set('Courriel', courriel);
      donnees.set('Code postal', String(saisie.get('code_postal') ?? ''));
      donnees.set('Langue', LANGUE);
      donnees.set('_subject', `${DICO.sujetListeAttente} — ${saisie.get('code_postal')}`);
      donnees.set('_replyto', courriel);
      try {
        const reponse = await fetch(FORMSPREE_PREVENEZ_MOI, {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: donnees,
        });
        if (!reponse.ok) throw new Error();
        prevenir.hidden = true;
        suite.textContent = DICO.note;
        suite.classList.remove('suite--erreur');
      } catch {
        suite.textContent = DICO.echecEnvoi;
        suite.classList.add('suite--erreur');
      }
      suite.hidden = false;
    });
  }
</script>
